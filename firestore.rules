rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Simple, Reliable Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid != null
        && (
          !('firebase' in request.auth.token) ||
          !('sign_in_provider' in request.auth.token.firebase) ||
          request.auth.token.firebase.sign_in_provider != 'anonymous'
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          request.auth.token.email.lower() == 'mifumomaster@gmail.com'
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAccountActiveData(userData) {
      return !('accountStatus' in userData) || userData.accountStatus != 'suspended';
    }

    function isNotSuspended() {
      return isSignedIn() && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        isAccountActiveData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
      );
    }

    function mchartGroupExists() {
      return exists(/databases/$(database)/documents/site_settings/mchart_group);
    }

    function mchartGroupData() {
      return get(/databases/$(database)/documents/site_settings/mchart_group).data;
    }

    function isNotKickedFromMchartGroup() {
      return isAdmin() || !mchartGroupExists() || !('kickedUids' in mchartGroupData()) || !(request.auth.uid in mchartGroupData().kickedUids);
    }

    function mchartGroupAllowsSend() {
      return isAdmin() || !mchartGroupExists() || (
        mchartGroupData().isLocked != true &&
        (!('kickedUids' in mchartGroupData()) || !(request.auth.uid in mchartGroupData().kickedUids))
      );
    }

    function canReadProtectedNoteContent(noteId) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/mchart_notes/$(noteId)) && (
          !('isLocked' in get(/databases/$(database)/documents/mchart_notes/$(noteId)).data) ||
          get(/databases/$(database)/documents/mchart_notes/$(noteId)).data.isLocked == false ||
          (
            exists(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)).data.status == 'unlocked'
          ) ||
          (
            'lockedTargetMode' in get(/databases/$(database)/documents/mchart_notes/$(noteId)).data &&
            get(/databases/$(database)/documents/mchart_notes/$(noteId)).data.lockedTargetMode == 'selected' &&
            (
              !exists(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)) ||
              get(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)).data.status != 'locked'
            )
          )
        )
      );
    }

    function pollDocData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    // 3. Admins
    match /admins/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // 4. Users + Isolated Private Info + Notifications + Followers
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && (
          isAdmin() ||
          (
            (!('role' in incoming()) || incoming().role == 'member') &&
            (!('verificationBadge' in incoming()) || incoming().verificationBadge == 'none') &&
            (!('accountStatus' in incoming()) || incoming().accountStatus == 'active')
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            isAccountActiveData(existing()) &&
            incoming().role == existing().role &&
            (!('accountStatus' in incoming()) || !('accountStatus' in existing()) || incoming().accountStatus == existing().accountStatus) &&
            (!('verificationBadge' in incoming()) || !('verificationBadge' in existing()) || incoming().verificationBadge == existing().verificationBadge)
          ) ||
          (
            isNotSuspended() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create, update: if isSignedIn() && isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow delete: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
      }

      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isNotSuspended() && isValidId(userId) && isValidId(notificationId);
        allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      }

      match /followers/{followerId} {
        allow get, list: if isSignedIn();
        allow create: if isNotSuspended() && isValidId(userId) && isValidId(followerId) && (followerId == request.auth.uid || isAdmin());
        allow update: if false;
        allow delete: if isSignedIn() && (followerId == request.auth.uid || isAdmin());
      }
    }

    // 5. Forum Topics (Kijiweni, Fursa, Makala) & Subcollections
    match /topics/{topicId} {
      allow get: if isValidId(topicId)
        && (
          existing().status in ['open', 'locked'] ||
          (isAdmin() && existing().status != 'private') ||
          (isSignedIn() && existing().authorId == request.auth.uid)
        );

      allow list: if resource.data.status in ['open', 'locked']
        || (isAdmin() && resource.data.status != 'private')
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(topicId)
        && incoming().authorId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 300
        && incoming().body is string && incoming().body.size() <= 50000;

      allow update: if isSignedIn()
        && isValidId(topicId)
        && isNotSuspended()
        && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 300))
        && (!('body' in incoming()) || (incoming().body is string && incoming().body.size() <= 50000))
        && (
          (isAdmin() && existing().status != 'private') ||
          existing().authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'lastActivityAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount'])
        );

      allow delete: if isSignedIn()
        && isValidId(topicId)
        && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

      match /votes/{userId} {
        allow get: if isSignedIn() && isValidId(topicId) && isValidId(userId);
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isNotSuspended() && isValidId(topicId) && isValidId(userId) && userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(topicId) && isValidId(userId) && (isAdmin() || userId == request.auth.uid);
      }

      match /replies/{replyId} {
        allow get: if isValidId(topicId)
          && isValidId(replyId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(replyId)
          && incoming().authorId == request.auth.uid;

        allow update: if isSignedIn()
          && isValidId(topicId)
          && isValidId(replyId)
          && isNotSuspended()
          && (
            isAdmin() ||
            existing().authorId == request.auth.uid ||
            incoming().diff(existing()).affectedKeys().hasOnly(['isAcceptedAnswer', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount'])
          );

        allow delete: if isSignedIn()
          && isValidId(topicId)
          && isValidId(replyId)
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

        match /votes/{userId} {
          allow get: if isSignedIn() && isValidId(topicId) && isValidId(replyId) && isValidId(userId);
          allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
          allow create: if isNotSuspended() && isValidId(topicId) && isValidId(replyId) && isValidId(userId) && userId == request.auth.uid;
          allow update: if false;
          allow delete: if isSignedIn() && isValidId(topicId) && isValidId(replyId) && isValidId(userId) && (isAdmin() || userId == request.auth.uid);
        }
      }
    }

    // 6. Moderation Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (isAdmin() || existing().reporterId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);
      allow create: if isNotSuspended() && isValidId(reportId) && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin() && isValidId(reportId);
    }

    // 7. Mchart Community Group Chat & Read Cursors
    match /forum_chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && isNotKickedFromMchartGroup();
      allow list: if isSignedIn();

      allow create: if isNotSuspended()
        && isValidId(messageId)
        && mchartGroupAllowsSend()
        && incoming().senderId == request.auth.uid;

      allow update: if isNotSuspended()
        && isValidId(messageId)
        && (
          isAdmin() ||
          existing().senderId == request.auth.uid ||
          (
            isNotKickedFromMchartGroup() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(messageId)
        && (isAdmin() || (isNotSuspended() && existing().senderId == request.auth.uid));
    }

    match /mchart_group_reads/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isNotSuspended() && isValidId(userId) && isOwner(userId);
      allow delete: if isSignedIn() && (isAdmin() || isOwner(userId));
    }

    // 8. Mchart Notes & Protected Paid Content
    match /mchart_notes/{noteId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(noteId);

      match /content/{docId} {
        allow get: if isValidId(noteId) && docId == 'full' && canReadProtectedNoteContent(noteId);
        allow list: if false;
        allow create, update, delete: if isAdmin() && isValidId(noteId) && docId == 'full';
      }

      match /access/{userId} {
        allow get: if isValidId(noteId) && isValidId(userId) && (isAdmin() || isOwner(userId));
        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if isSignedIn() && isValidId(noteId) && isValidId(userId) && (isAdmin() || (isNotSuspended() && isOwner(userId)));
        allow delete: if isAdmin() && isValidId(noteId) && isValidId(userId);
      }
    }

    // 9. Member IDs, Directory & Presence
    match /member_ids/{cardId} {
      allow get: if isValidId(cardId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isSignedIn() && isValidId(cardId) && (isAdmin() || isOwner(incoming().uid));
      allow delete: if isAdmin() && isValidId(cardId);
    }

    match /member_directory/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /user_presence/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.isOnline == true || isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 10. Private 1-on-1 Direct Chats (Strictly Participant-Only)
    match /direct_chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isNotSuspended() && isValidId(chatId) && request.auth.uid in incoming().participants;
      allow update: if isNotSuspended() && isValidId(chatId) && request.auth.uid in existing().participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && request.auth.uid in existing().participants;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if isNotSuspended() && isValidId(chatId) && isValidId(messageId) && incoming().senderId == request.auth.uid && request.auth.uid in incoming().participants;
        allow update: if isNotSuspended() && isValidId(chatId) && isValidId(messageId) && request.auth.uid in existing().participants;
        allow delete: if isNotSuspended() && isValidId(chatId) && isValidId(messageId) && existing().senderId == request.auth.uid;
      }
    }

    // 11. WhatsApp-Style 24h Photo & Video Statuses
    match /mchart_statuses/{statusId} {
      allow get: if isValidId(statusId)
        && isSignedIn()
        && (
          existing().authorId == request.auth.uid ||
          '__MEMBERS__' in existing().audienceTokens ||
          request.auth.uid in existing().audienceTokens
        );

      allow list: if isSignedIn()
        && (
          '__MEMBERS__' in resource.data.audienceTokens ||
          request.auth.uid in resource.data.audienceTokens ||
          resource.data.authorId == request.auth.uid
        );

      allow create: if isNotSuspended() && isValidId(statusId) && incoming().authorId == request.auth.uid;
      allow update: if isNotSuspended() && isValidId(statusId) && (
        existing().authorId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
      );
      allow delete: if isSignedIn() && isValidId(statusId) && (existing().authorId == request.auth.uid || isAdmin());

      match /views/{viewerId} {
        allow get: if isSignedIn() && isValidId(statusId) && isValidId(viewerId) && (viewerId == request.auth.uid || existing().statusAuthorId == request.auth.uid);
        allow list: if isSignedIn() && (resource.data.statusAuthorId == request.auth.uid || resource.data.viewerId == request.auth.uid);
        allow create: if isNotSuspended() && isValidId(statusId) && isValidId(viewerId) && isOwner(viewerId);
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(statusId) && isValidId(viewerId) && (existing().statusAuthorId == request.auth.uid || isAdmin());
      }
    }

    // 12. Videos & Reels
    match /videos/{videoId} {
      allow get: if isValidId(videoId)
        && (existing().isArchived == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

      allow list: if resource.data.isArchived == false
        || isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isNotSuspended() && isValidId(videoId) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(videoId)
        && isNotSuspended()
        && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount'])
        );
      allow delete: if isSignedIn() && isValidId(videoId) && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(userId);
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isNotSuspended() && isValidId(videoId) && isValidId(userId) && userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(videoId) && isValidId(userId) && (isAdmin() || userId == request.auth.uid);
      }

      match /comments/{commentId} {
        allow get: if isValidId(videoId)
          && isValidId(commentId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended() && isValidId(videoId) && isValidId(commentId);
        allow update: if isSignedIn() && isValidId(videoId) && isValidId(commentId) && (isAdmin() || existing().authorId == request.auth.uid);
        allow delete: if isSignedIn() && isValidId(videoId) && isValidId(commentId) && (isAdmin() || existing().authorId == request.auth.uid);
      }
    }

    // 13. Site Settings (Navigation, Community Stats, Mchart Group Settings, Retention)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'navigation' ||
        settingId == 'community_stats' ||
        settingId == 'mchart_group' ||
        isAdmin()
      );
      allow list: if false;

      allow create, update: if isValidId(settingId) && (
        isAdmin() ||
        (settingId == 'community_stats' && isSignedIn())
      );

      allow delete: if isAdmin() && isValidId(settingId);
    }

    // 14. Owner Specimen ID Cards, Certificates & Private Photo Vault
    match /owner_id_cards/{cardId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(cardId);
    }

    match /training_certificates/{certId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(certId);
    }

    match /owner_private_photos/{photoId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(photoId);
    }

    match /owner_photo_folders/{folderId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(folderId);
    }

    // 15. Community Polls & Voting
    match /polls/{pollId} {
      allow get: if isValidId(pollId)
        && (existing().status in ['open', 'closed'] || isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid));

      allow list: if resource.data.status in ['open', 'closed']
        || isAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);

      allow create: if isSignedIn() && isValidId(pollId) && incoming().createdBy == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(pollId)
        && (
          isAdmin() ||
          ('createdBy' in existing() && existing().createdBy == request.auth.uid) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['totalBallots', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
        );

      allow delete: if isSignedIn()
        && isValidId(pollId)
        && (isAdmin() || ('createdBy' in existing() && existing().createdBy == request.auth.uid));

      match /tallies/{optionId} {
        allow get, list: if isValidId(pollId) && isValidId(optionId);
        allow create, update: if isSignedIn() && isValidId(pollId) && isValidId(optionId);
        allow delete: if isSignedIn() && isValidId(pollId) && isValidId(optionId) && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/polls/$(pollId)) && 'createdBy' in pollDocData(pollId) && pollDocData(pollId).createdBy == request.auth.uid)
        );
      }

      match /ballots/{userId} {
        allow get: if isSignedIn() && isValidId(pollId) && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if isSignedIn() && isValidId(pollId) && isValidId(userId) && isOwner(userId);
        allow delete: if isAdmin() && isValidId(pollId) && isValidId(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(pollId) && isValidId(commentId);
        allow list: if true;
        allow create: if isSignedIn() && isValidId(pollId) && isValidId(commentId) && incoming().authorId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(pollId) && isValidId(commentId) && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
        );
        allow delete: if isSignedIn() && isValidId(pollId) && isValidId(commentId) && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          (exists(/databases/$(database)/documents/polls/$(pollId)) && 'createdBy' in pollDocData(pollId) && pollDocData(pollId).createdBy == request.auth.uid)
        );

        match /likes/{userId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && isValidId(pollId) && isValidId(commentId) && isValidId(userId) && userId == request.auth.uid;
          allow update: if false;
          allow delete: if isSignedIn() && isValidId(pollId) && isValidId(commentId) && isValidId(userId) && (isAdmin() || userId == request.auth.uid);
        }
      }
    }

    // 16. Poll Tournaments
    match /poll_tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(tournamentId) && incoming().createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(tournamentId) && (isAdmin() || ('createdBy' in existing() && existing().createdBy == request.auth.uid));
    }
  }
}
