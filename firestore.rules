rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mifumomaster@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotSuspended() {
      return isSignedIn() && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'suspended'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'bio', 'role',
          'topicsCount', 'repliesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'role', 'verificationBadge',
          'accountStatus', 'suspendedReason',
          'topicsCount', 'repliesCount', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.bio is string && data.bio.size() <= 300
        && data.role in ['member', 'moderator']
        && (!('verificationBadge' in data) || (data.verificationBadge is string && data.verificationBadge in ['none', 'individual', 'organization', 'government', 'owner']))
        && (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['active', 'suspended']))
        && (!('suspendedReason' in data) || (data.suspendedReason is string && data.suspendedReason.size() <= 300))
        && data.topicsCount is int && data.topicsCount >= 0
        && data.repliesCount is int && data.repliesCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTagsList(tags) {
      return tags is list
        && tags.size() <= 5
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 30));
    }

    function isValidTopic(data) {
      return data.keys().hasAll([
          'title', 'body', 'category', 'tags', 'authorId', 'authorName', 'authorPhoto',
          'status', 'isPinned', 'repliesCount', 'upvotesCount', 'acceptedReplyId',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.keys().hasOnly([
          'title', 'body', 'category', 'tags', 'authorId', 'authorName', 'authorPhoto',
          'status', 'isPinned', 'repliesCount', 'upvotesCount', 'acceptedReplyId',
          'company', 'location', 'jobType', 'deadline', 'applyInfo', 'coverImage',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.title is string && data.title.size() <= 140
        && data.body is string && data.body.size() <= 8000
        && (
          (data.title.size() >= 5 && data.body.size() >= 10) ||
          (data.category == 'Kijiweni' && 'coverImage' in data && data.coverImage is string && data.coverImage.size() >= 10 && data.coverImage.size() <= 500)
        )
        && data.category in [
          'Kijiweni', 'Fursa', 'Makala',
          'Habari na Hoja', 'Jukwaa la Siasa', 'Jamii Intelligence',
          'Biashara & Uchumi', 'Mahusiano (MMU)', 'Teknolojia & Sayansi',
          'Elimu & Ajira', 'Michezo & Burudani',
          'Teknolojia', 'Biashara', 'Elimu', 'Jamii', 'Sayansi', 'Michezo'
        ]
        && isValidTagsList(data.tags)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.status in ['open', 'locked', 'archived']
        && data.isPinned is bool
        && data.repliesCount is int && data.repliesCount >= 0
        && data.upvotesCount is int && data.upvotesCount >= 0
        && data.acceptedReplyId is string && data.acceptedReplyId.size() <= 128
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('jobType' in data) || (data.jobType is string && data.jobType.size() <= 40))
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 60))
        && (!('applyInfo' in data) || (data.applyInfo is string && data.applyInfo.size() <= 300))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastActivityAt is timestamp;
    }

    function isValidReply(data, topicId) {
      return data.keys().hasAll([
          'topicId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentReplyId', 'isAcceptedAnswer', 'upvotesCount', 'isDeleted',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'topicId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentReplyId', 'isAcceptedAnswer', 'upvotesCount', 'isDeleted',
          'createdAt', 'updatedAt'
        ])
        && data.topicId is string && data.topicId == topicId && data.topicId.size() <= 128
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 4000
        && data.parentReplyId is string && data.parentReplyId.size() <= 128
        && data.isAcceptedAnswer is bool
        && data.upvotesCount is int && data.upvotesCount >= 0
        && data.isDeleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVote(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
          'reporterId', 'targetType', 'targetId', 'topicId',
          'reason', 'details', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'topicId',
          'reason', 'details', 'status', 'createdAt'
        ])
        && data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128
        && data.targetType in ['topic', 'reply']
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128
        && data.reason in ['spam', 'harassment', 'misinformation', 'unlawful', 'other']
        && data.details is string && data.details.size() <= 500
        && data.status in ['pending', 'reviewed', 'dismissed']
        && data.createdAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderPhoto is string && data.senderPhoto.size() <= 500
        && data.text is string && data.text.size() <= 2000
        && data.attachmentType in ['none', 'image', 'document']
        && data.attachmentUrl is string && data.attachmentUrl.size() <= 500
        && data.attachmentName is string && data.attachmentName.size() <= 140
        && data.attachmentSize is int && data.attachmentSize >= 0 && data.attachmentSize <= 15728640
        && data.attachmentMime is string && data.attachmentMime.size() <= 120
        && data.replyToId is string && data.replyToId.size() <= 128
        && data.replyToSenderName is string && data.replyToSenderName.size() <= 80
        && data.replyToPreview is string && data.replyToPreview.size() <= 160
        && data.isDeleted is bool
        && (
          data.isDeleted == true ||
          data.text.size() >= 1 ||
          (data.attachmentType in ['image', 'document'] && data.attachmentUrl.size() >= 10)
        )
        && (
          data.attachmentType == 'none' ||
          (data.attachmentUrl.size() >= 10 && data.attachmentUrl.matches('^https://.*'))
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMchartNote(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'body', 'summary',
          'fileName', 'wordCount', 'isArchived', 'isPinned',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'subtitle', 'body', 'summary',
          'fileName', 'wordCount', 'isArchived', 'isPinned',
          'pdfUrl', 'pdfFileName', 'pdfSize', 'noteType',
          'isLocked', 'lockedTargetMode', 'lockPrice', 'lockCurrency', 'paymentInstructions',
          'createdAt', 'updatedAt'
        ])
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 220))
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 15000
        && data.summary is string && data.summary.size() <= 240
        && data.fileName is string && data.fileName.size() >= 3 && data.fileName.size() <= 120
        && data.wordCount is int && data.wordCount >= 1 && data.wordCount <= 50000
        && data.isArchived is bool
        && data.isPinned is bool
        && (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 500 && (data.pdfUrl == '' || data.pdfUrl.matches('^https://.*'))))
        && (!('pdfFileName' in data) || (data.pdfFileName is string && data.pdfFileName.size() <= 140))
        && (!('pdfSize' in data) || (data.pdfSize is int && data.pdfSize >= 0 && data.pdfSize <= 20971520))
        && (!('noteType' in data) || (data.noteType is string && data.noteType in ['text', 'pdf', 'mixed']))
        && (!('isLocked' in data) || data.isLocked is bool)
        && (!('lockedTargetMode' in data) || (data.lockedTargetMode is string && data.lockedTargetMode in ['all', 'selected']))
        && (!('lockPrice' in data) || (data.lockPrice is int && data.lockPrice >= 0 && data.lockPrice <= 100000000))
        && (!('lockCurrency' in data) || (data.lockCurrency is string && data.lockCurrency.size() <= 10))
        && (!('paymentInstructions' in data) || (data.paymentInstructions is string && data.paymentInstructions.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNoteProtectedContent(data, noteId) {
      return data.keys().hasAll(['noteId', 'body', 'pdfUrl', 'pdfFileName', 'pdfSize', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'body', 'pdfUrl', 'pdfFileName', 'pdfSize', 'updatedAt'])
        && data.noteId is string && data.noteId == noteId && data.noteId.size() <= 128
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 15000
        && data.pdfUrl is string && data.pdfUrl.size() <= 500 && (data.pdfUrl == '' || data.pdfUrl.matches('^https://.*'))
        && data.pdfFileName is string && data.pdfFileName.size() <= 140
        && data.pdfSize is int && data.pdfSize >= 0 && data.pdfSize <= 20971520
        && data.updatedAt is timestamp;
    }

    function isValidNoteAccess(data, noteId, userId) {
      return data.keys().hasAll(['noteId', 'userId', 'userName', 'status', 'paymentReference', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'userId', 'userName', 'status', 'paymentReference', 'createdAt', 'updatedAt'])
        && data.noteId is string && data.noteId == noteId && data.noteId.size() <= 128
        && data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.status in ['pending', 'unlocked', 'locked']
        && data.paymentReference is string && data.paymentReference.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function noteDocData(noteId) {
      return get(/databases/$(database)/documents/mchart_notes/$(noteId)).data;
    }

    function hasNoteAccessDoc(noteId) {
      return exists(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid));
    }

    function noteAccessStatus(noteId) {
      return get(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)).data.status;
    }

    function canReadProtectedNoteContent(noteId) {
      return isAdmin() || (
        isSignedIn() && (
          !('isLocked' in noteDocData(noteId)) ||
          noteDocData(noteId).isLocked != true ||
          (hasNoteAccessDoc(noteId) && noteAccessStatus(noteId) == 'unlocked') ||
          (
            ('lockedTargetMode' in noteDocData(noteId)) &&
            noteDocData(noteId).lockedTargetMode == 'selected' &&
            (!hasNoteAccessDoc(noteId) || (noteAccessStatus(noteId) != 'locked' && noteAccessStatus(noteId) != 'pending'))
          )
        )
      );
    }

    // 4. Admins Collection
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // 5. Public User Profiles + Isolated PII Subcollection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'member' || isAdmin())
        && (!('verificationBadge' in incoming()) || incoming().verificationBadge == 'none' || isAdmin())
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active' || isAdmin())
        && (!('suspendedReason' in incoming()) || incoming().suspendedReason == '' || isAdmin())
        && incoming().topicsCount == 0
        && incoming().repliesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            (!('accountStatus' in existing()) || existing().accountStatus != 'suspended') &&
            incoming().role == existing().role &&
            (
              (!('verificationBadge' in incoming()) && !('verificationBadge' in existing())) ||
              ('verificationBadge' in existing() && 'verificationBadge' in incoming() && incoming().verificationBadge == existing().verificationBadge) ||
              (!('verificationBadge' in existing()) && 'verificationBadge' in incoming() && incoming().verificationBadge == 'none')
            ) &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt']) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['topicsCount', 'updatedAt']) &&
                (incoming().topicsCount == existing().topicsCount + 1 || incoming().topicsCount == existing().topicsCount - 1)
              ) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'updatedAt']) &&
                (incoming().repliesCount == existing().repliesCount + 1 || incoming().repliesCount == existing().repliesCount - 1)
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isNotSuspended()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'updatedAt']);

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && docId == 'info';
      }
    }

    // 6. Forum Topics & Subcollections
    match /topics/{topicId} {
      allow get: if isValidId(topicId)
        && (existing().status in ['open', 'locked'] || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

      allow list: if resource.data.status in ['open', 'locked']
        || isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(topicId)
        && isValidTopic(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open'
        && (incoming().isPinned == false || isAdmin())
        && incoming().repliesCount == 0
        && incoming().upvotesCount == 0
        && incoming().acceptedReplyId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastActivityAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(topicId)
        && isValidTopic(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (existing().status != 'archived' || isAdmin())
        && (
          // Action 1: Admin Moderation
          (
            isAdmin() &&
            incoming().updatedAt == request.time
          ) ||
          // Action 2: Author Content Edit
          (
            existing().authorId == request.auth.uid &&
            existing().status == 'open' &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'category', 'tags',
              'company', 'location', 'jobType', 'deadline', 'applyInfo', 'coverImage',
              'updatedAt'
            ])
          ) ||
          // Action 3: Author Lock / Archive
          (
            existing().authorId == request.auth.uid &&
            existing().status in ['open', 'locked'] &&
            incoming().status in ['open', 'locked', 'archived'] &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 4: Author Accepts Best Reply
          (
            existing().authorId == request.auth.uid &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['acceptedReplyId', 'updatedAt'])
          ) ||
          // Action 5: Reply Activity Counter Sync
          (
            existing().status == 'open' &&
            incoming().updatedAt == request.time &&
            incoming().lastActivityAt == request.time &&
            (incoming().repliesCount == existing().repliesCount + 1 || incoming().repliesCount == existing().repliesCount - 1) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'lastActivityAt', 'updatedAt'])
          ) ||
          // Action 6: Atomic Upvote Sync
          (
            existing().status in ['open', 'locked'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount']) &&
            (
              (
                incoming().upvotesCount == existing().upvotesCount + 1 &&
                !exists(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid))
              ) ||
              (
                incoming().upvotesCount == existing().upvotesCount - 1 &&
                exists(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid)) &&
                !existsAfter(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid))
              )
            )
          )
        );

      allow delete: if isSignedIn()
        && isValidId(topicId)
        && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

      // Topic Votes
      match /votes/{userId} {
        allow get: if isSignedIn() && isValidId(topicId) && isValidId(userId) && userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

        allow create: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidVote(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/topics/$(topicId));

        allow update: if false;
        allow delete: if isNotSuspended() && isValidId(topicId) && isValidId(userId) && userId == request.auth.uid;
      }

      // Topic Replies Subcollection
      match /replies/{replyId} {
        allow get: if isValidId(topicId)
          && isValidId(replyId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(replyId)
          && isValidReply(incoming(), topicId)
          && incoming().authorId == request.auth.uid
          && incoming().isAcceptedAnswer == false
          && incoming().upvotesCount == 0
          && incoming().isDeleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/topics/$(topicId))
          && get(/databases/$(database)/documents/topics/$(topicId)).data.status == 'open'
          && getAfter(/databases/$(database)/documents/topics/$(topicId)).data.repliesCount ==
             get(/databases/$(database)/documents/topics/$(topicId)).data.repliesCount + 1;

        allow update: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(replyId)
          && isValidReply(incoming(), topicId)
          && incoming().topicId == existing().topicId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && (
            // Action 1: Admin Moderation
            (
              isAdmin() &&
              incoming().updatedAt == request.time
            ) ||
            // Action 2: Author Reply Edit
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              get(/databases/$(database)/documents/topics/$(topicId)).data.status == 'open' &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt'])
            ) ||
            // Action 3: Author Soft Delete
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              incoming().isDeleted == true &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'body', 'updatedAt'])
            ) ||
            // Action 4: Topic Author Accepts / Unaccepts Reply
            (
              get(/databases/$(database)/documents/topics/$(topicId)).data.authorId == request.auth.uid &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isAcceptedAnswer', 'updatedAt'])
            ) ||
            // Action 5: Atomic Reply Upvote Sync
            (
              existing().isDeleted == false &&
              incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount']) &&
              (
                (
                  incoming().upvotesCount == existing().upvotesCount + 1 &&
                  !exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid)) &&
                  existsAfter(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid))
                ) ||
                (
                  incoming().upvotesCount == existing().upvotesCount - 1 &&
                  exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid)) &&
                  !existsAfter(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid))
                )
              )
            )
          );

        allow delete: if isSignedIn()
          && isValidId(topicId)
          && isValidId(replyId)
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

        // Reply Votes
        match /votes/{userId} {
          allow get: if isSignedIn() && isValidId(topicId) && isValidId(replyId) && isValidId(userId) && userId == request.auth.uid;
          allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

          allow create: if isNotSuspended()
            && isValidId(topicId)
            && isValidId(replyId)
            && isValidId(userId)
            && userId == request.auth.uid
            && isValidVote(incoming(), userId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId));

          allow update: if false;
          allow delete: if isNotSuspended() && isValidId(topicId) && isValidId(replyId) && isValidId(userId) && userId == request.auth.uid;
        }
      }
    }

    // 7. Moderation Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (isAdmin() || existing().reporterId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/topics/$(incoming().topicId));

      allow update: if isAdmin()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // 8. Community Group Chat Messages
    match /forum_chat_messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if (resource.data.createdAt >= timestamp.date(1970, 1, 1) && request.query.limit <= 200)
        || isAdmin()
        || (isSignedIn() && resource.data.senderId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(messageId)
        && isValidChatMessage(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().isDeleted == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(messageId)
        && isValidChatMessage(incoming())
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().senderId == request.auth.uid &&
            existing().isDeleted == false &&
            incoming().isDeleted == true &&
            incoming().attachmentType == 'none' &&
            incoming().attachmentUrl == '' &&
            incoming().attachmentName == '' &&
            incoming().attachmentSize == 0 &&
            incoming().attachmentMime == ''
          )
        );

      allow delete: if isSignedIn()
        && isValidId(messageId)
        && (isAdmin() || (isNotSuspended() && existing().senderId == request.auth.uid));
    }

    // 9. Owner Mchart Notes & Archive Files
    match /mchart_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if (resource.data.createdAt >= timestamp.date(1970, 1, 1) && request.query.limit <= 100)
        || isAdmin();

      allow create: if isAdmin()
        && isValidId(noteId)
        && isValidMchartNote(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(noteId)
        && isValidMchartNote(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(noteId);

      // Protected Full Body & PDF URL for Paid / Locked Notes
      match /content/{docId} {
        allow get: if isValidId(noteId)
          && docId == 'full'
          && canReadProtectedNoteContent(noteId);
        allow list: if false;

        allow create, update: if isAdmin()
          && isValidId(noteId)
          && docId == 'full'
          && isValidNoteProtectedContent(incoming(), noteId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/mchart_notes/$(noteId));

        allow delete: if isAdmin() && isValidId(noteId) && docId == 'full';
      }

      // Per-User Payment Unlock & Targeted Lock Records
      match /access/{userId} {
        allow get: if isValidId(noteId) && isValidId(userId) && (isAdmin() || isOwner(userId));
        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

        allow create: if isSignedIn()
          && isValidId(noteId)
          && isValidId(userId)
          && isValidNoteAccess(incoming(), noteId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/mchart_notes/$(noteId))
          && (
            isAdmin() ||
            (
              isNotSuspended() &&
              isOwner(userId) &&
              incoming().status == 'pending'
            )
          );

        allow update: if isSignedIn()
          && isValidId(noteId)
          && isValidId(userId)
          && isValidNoteAccess(incoming(), noteId, userId)
          && incoming().noteId == existing().noteId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isNotSuspended() &&
              isOwner(userId) &&
              existing().status != 'unlocked' &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'userName', 'paymentReference', 'updatedAt'])
            )
          );

        allow delete: if isAdmin() && isValidId(noteId) && isValidId(userId);
      }
    }
  }
}
