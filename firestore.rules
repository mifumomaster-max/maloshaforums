rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mifumomaster@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAccountActiveData(userData) {
      return !('accountStatus' in userData) || userData.accountStatus != 'suspended';
    }

    function isNotSuspended() {
      return isSignedIn() && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        isAccountActiveData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'bio', 'role',
          'topicsCount', 'repliesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'role', 'verificationBadge',
          'accountStatus', 'suspendedReason', 'suspendedRuleNumber',
          'topicsCount', 'repliesCount', 'followersCount', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.bio is string && data.bio.size() <= 300
        && data.role in ['member', 'moderator']
        && (!('verificationBadge' in data) || (data.verificationBadge is string && data.verificationBadge in ['none', 'individual', 'organization', 'government', 'owner', 'journalist', 'educator', 'creator']))
        && (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['active', 'suspended']))
        && (!('suspendedReason' in data) || (data.suspendedReason is string && data.suspendedReason.size() <= 300))
        && (!('suspendedRuleNumber' in data) || (data.suspendedRuleNumber is int && data.suspendedRuleNumber >= 0 && data.suspendedRuleNumber <= 13))
        && data.topicsCount is int && data.topicsCount >= 0
        && data.repliesCount is int && data.repliesCount >= 0
        && (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserFollower(data, followerId) {
      return data.keys().hasAll(['followerId', 'followerName', 'followerPhoto', 'createdAt'])
        && data.keys().hasOnly(['followerId', 'followerName', 'followerPhoto', 'createdAt'])
        && data.followerId is string && data.followerId == followerId && isValidId(data.followerId)
        && data.followerName is string && data.followerName.size() >= 1 && data.followerName.size() <= 80
        && data.followerPhoto is string && data.followerPhoto.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTagsList(tags) {
      return tags is list
        && tags.size() <= 5
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 30));
    }

    function isValidTopic(data) {
      return data.keys().hasAll([
          'title', 'body', 'category', 'tags', 'authorId', 'authorName', 'authorPhoto',
          'status', 'isPinned', 'repliesCount', 'upvotesCount', 'acceptedReplyId',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.keys().hasOnly([
          'title', 'body', 'category', 'tags', 'authorId', 'authorName', 'authorPhoto',
          'status', 'isPinned', 'repliesCount', 'upvotesCount', 'acceptedReplyId',
          'company', 'location', 'jobType', 'deadline', 'applyInfo', 'coverImage',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.title is string && data.title.size() <= 140
        && data.body is string && data.body.size() <= 8000
        && (
          (data.title.size() >= 5 && data.body.size() >= 10) ||
          (data.category == 'Kijiweni' && 'coverImage' in data && data.coverImage is string && data.coverImage.size() >= 10 && data.coverImage.size() <= 500)
        )
        && data.category in [
          'Kijiweni', 'Fursa', 'Makala',
          'Habari na Hoja', 'Jukwaa la Siasa', 'Jamii Intelligence',
          'Biashara & Uchumi', 'Mahusiano (MMU)', 'Teknolojia & Sayansi',
          'Elimu & Ajira', 'Michezo & Burudani',
          'Teknolojia', 'Biashara', 'Elimu', 'Jamii', 'Sayansi', 'Michezo'
        ]
        && isValidTagsList(data.tags)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.status in ['open', 'locked', 'archived']
        && data.isPinned is bool
        && data.repliesCount is int && data.repliesCount >= 0
        && data.upvotesCount is int && data.upvotesCount >= 0
        && data.acceptedReplyId is string && data.acceptedReplyId.size() <= 128
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('jobType' in data) || (data.jobType is string && data.jobType.size() <= 40))
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 60))
        && (!('applyInfo' in data) || (data.applyInfo is string && data.applyInfo.size() <= 300))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastActivityAt is timestamp;
    }

    function isValidReply(data, topicId) {
      return data.keys().hasAll([
          'topicId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentReplyId', 'isAcceptedAnswer', 'upvotesCount', 'isDeleted',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'topicId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentReplyId', 'isAcceptedAnswer', 'upvotesCount', 'isDeleted',
          'createdAt', 'updatedAt'
        ])
        && data.topicId is string && data.topicId == topicId && data.topicId.size() <= 128
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 4000
        && data.parentReplyId is string && data.parentReplyId.size() <= 128
        && data.isAcceptedAnswer is bool
        && data.upvotesCount is int && data.upvotesCount >= 0
        && data.isDeleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVote(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
          'reporterId', 'targetType', 'targetId', 'topicId',
          'reason', 'details', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'topicId',
          'reason', 'ruleNumber', 'details', 'status', 'createdAt'
        ])
        && data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128
        && data.targetType in ['topic', 'reply', 'video']
        && data.targetId is string && isValidId(data.targetId)
        && data.topicId is string && isValidId(data.topicId)
        && data.reason in ['spam', 'harassment', 'misinformation', 'unlawful', 'other']
        && (!('ruleNumber' in data) || (data.ruleNumber is int && data.ruleNumber >= 0 && data.ruleNumber <= 13))
        && data.details is string && data.details.size() <= 500
        && data.status in ['pending', 'reviewed', 'dismissed']
        && data.createdAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderPhoto is string && data.senderPhoto.size() <= 500
        && data.text is string && data.text.size() <= 2000
        && data.attachmentType in ['none', 'image', 'document']
        && data.attachmentUrl is string && data.attachmentUrl.size() <= 500
        && data.attachmentName is string && data.attachmentName.size() <= 140
        && data.attachmentSize is int && data.attachmentSize >= 0 && data.attachmentSize <= 15728640
        && data.attachmentMime is string && data.attachmentMime.size() <= 120
        && data.replyToId is string && data.replyToId.size() <= 128
        && data.replyToSenderName is string && data.replyToSenderName.size() <= 80
        && data.replyToPreview is string && data.replyToPreview.size() <= 160
        && data.isDeleted is bool
        && (
          data.isDeleted == true ||
          data.text.size() >= 1 ||
          (data.attachmentType in ['image', 'document'] && data.attachmentUrl.size() >= 10)
        )
        && (
          data.attachmentType == 'none' ||
          (data.attachmentUrl.size() >= 10 && data.attachmentUrl.matches('^https://.*'))
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMchartNote(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'body', 'summary',
          'fileName', 'wordCount', 'isArchived', 'isPinned',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'subtitle', 'body', 'summary',
          'fileName', 'wordCount', 'isArchived', 'isPinned',
          'pdfUrl', 'pdfFileName', 'pdfSize', 'noteType',
          'isLocked', 'lockedTargetMode', 'lockPrice', 'lockCurrency', 'paymentInstructions',
          'createdAt', 'updatedAt'
        ])
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 220))
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 15000
        && data.summary is string && data.summary.size() <= 240
        && data.fileName is string && data.fileName.size() >= 3 && data.fileName.size() <= 120
        && data.wordCount is int && data.wordCount >= 1 && data.wordCount <= 50000
        && data.isArchived is bool
        && data.isPinned is bool
        && (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 500 && (data.pdfUrl == '' || data.pdfUrl.matches('^https://.*'))))
        && (!('pdfFileName' in data) || (data.pdfFileName is string && data.pdfFileName.size() <= 140))
        && (!('pdfSize' in data) || (data.pdfSize is int && data.pdfSize >= 0 && data.pdfSize <= 20971520))
        && (!('noteType' in data) || (data.noteType is string && data.noteType in ['text', 'pdf', 'mixed']))
        && (!('isLocked' in data) || data.isLocked is bool)
        && (!('lockedTargetMode' in data) || (data.lockedTargetMode is string && data.lockedTargetMode in ['all', 'selected']))
        && (!('lockPrice' in data) || (data.lockPrice is int && data.lockPrice >= 0 && data.lockPrice <= 100000000))
        && (!('lockCurrency' in data) || (data.lockCurrency is string && data.lockCurrency.size() <= 10))
        && (!('paymentInstructions' in data) || (data.paymentInstructions is string && data.paymentInstructions.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNoteProtectedContent(data, noteId) {
      return data.keys().hasAll(['noteId', 'body', 'pdfUrl', 'pdfFileName', 'pdfSize', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'body', 'pdfUrl', 'pdfFileName', 'pdfSize', 'updatedAt'])
        && data.noteId is string && data.noteId == noteId && data.noteId.size() <= 128
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 15000
        && data.pdfUrl is string && data.pdfUrl.size() <= 500 && (data.pdfUrl == '' || data.pdfUrl.matches('^https://.*'))
        && data.pdfFileName is string && data.pdfFileName.size() <= 140
        && data.pdfSize is int && data.pdfSize >= 0 && data.pdfSize <= 20971520
        && data.updatedAt is timestamp;
    }

    function isValidNoteAccess(data, noteId, userId) {
      return data.keys().hasAll(['noteId', 'userId', 'userName', 'status', 'paymentReference', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'userId', 'userName', 'status', 'paymentReference', 'createdAt', 'updatedAt'])
        && data.noteId is string && data.noteId == noteId && data.noteId.size() <= 128
        && data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.status in ['pending', 'unlocked', 'locked']
        && data.paymentReference is string && data.paymentReference.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberIdRecord(data, cardId) {
      return data.keys().hasAll([
          'cardNumber', 'controlSerial', 'uid', 'displayName', 'photoURL',
          'role', 'verificationBadge', 'accountStatus',
          'issuedAt', 'expiresAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'cardNumber', 'controlSerial', 'uid', 'displayName', 'photoURL',
          'role', 'verificationBadge', 'accountStatus',
          'issuedAt', 'expiresAt', 'updatedAt'
        ])
        && data.cardNumber is string && data.cardNumber == cardId && data.cardNumber.size() >= 6 && data.cardNumber.size() <= 32 && data.cardNumber.matches('^MLF-[A-Z0-9]+$')
        && data.controlSerial is string && data.controlSerial.size() == 8 && data.controlSerial.matches('^[0-9]{8}$')
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['member', 'moderator']
        && data.verificationBadge in ['none', 'individual', 'organization', 'government', 'owner', 'journalist', 'educator', 'creator']
        && data.accountStatus in ['active', 'suspended']
        && data.issuedAt is timestamp
        && data.expiresAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPresence(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'isOnline', 'isTypingInMchart',
          'replyingToName', 'activeArea', 'lastSeenAt', 'typingUpdatedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'isOnline', 'isTypingInMchart',
          'typingChatId', 'replyingToName', 'activeArea', 'lastSeenAt', 'typingUpdatedAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.isOnline is bool
        && data.isTypingInMchart is bool
        && (!('typingChatId' in data) || (data.typingChatId is string && data.typingChatId.size() <= 128))
        && data.replyingToName is string && data.replyingToName.size() <= 80
        && data.activeArea in ['kijiweni', 'video', 'fursa', 'makala', 'mchart', 'profile', 'forum']
        && data.lastSeenAt is timestamp
        && data.typingUpdatedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberDirectoryEntry(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'verificationBadge', 'isActive', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'verificationBadge', 'isActive', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.verificationBadge in ['none', 'individual', 'organization', 'government', 'owner', 'journalist', 'educator', 'creator']
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }

    function isValidDirectChat(data, chatId) {
      return data.keys().hasAll([
          'chatId', 'participantA', 'participantB', 'participants',
          'participantAName', 'participantAPhoto', 'participantBName', 'participantBPhoto',
          'lastMessageText', 'lastSenderId', 'lastMessageAt',
          'unreadCountA', 'unreadCountB', 'lastReadAtA', 'lastReadAtB',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chatId', 'participantA', 'participantB', 'participants',
          'participantAName', 'participantAPhoto', 'participantBName', 'participantBPhoto',
          'lastMessageText', 'lastSenderId', 'lastMessageAt',
          'unreadCountA', 'unreadCountB', 'lastReadAtA', 'lastReadAtB',
          'createdAt', 'updatedAt'
        ])
        && data.chatId is string && data.chatId == chatId && data.chatId.size() >= 3 && data.chatId.size() <= 128
        && data.participantA is string && isValidId(data.participantA)
        && data.participantB is string && isValidId(data.participantB)
        && data.participantA < data.participantB
        && data.chatId == data.participantA + '__' + data.participantB
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] == data.participantA
        && data.participants[1] == data.participantB
        && data.participantAName is string && data.participantAName.size() >= 1 && data.participantAName.size() <= 80
        && data.participantAPhoto is string && data.participantAPhoto.size() <= 500
        && data.participantBName is string && data.participantBName.size() >= 1 && data.participantBName.size() <= 80
        && data.participantBPhoto is string && data.participantBPhoto.size() <= 500
        && data.lastMessageText is string && data.lastMessageText.size() <= 200
        && data.lastSenderId is string && data.lastSenderId.size() <= 128
        && data.lastMessageAt is timestamp
        && data.unreadCountA is int && data.unreadCountA >= 0 && data.unreadCountA <= 100000
        && data.unreadCountB is int && data.unreadCountB >= 0 && data.unreadCountB <= 100000
        && data.lastReadAtA is timestamp
        && data.lastReadAtB is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data, chatId) {
      return data.keys().hasAll([
          'chatId', 'participants', 'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chatId', 'participants', 'senderId', 'senderName', 'senderPhoto', 'text',
          'attachmentType', 'attachmentUrl', 'attachmentName',
          'attachmentSize', 'attachmentMime',
          'replyToId', 'replyToSenderName', 'replyToPreview',
          'isDeleted', 'viewOnce', 'viewOnceConsumed', 'viewOnceOpenedAt',
          'createdAt', 'updatedAt'
        ])
        && data.chatId is string && data.chatId == chatId && data.chatId.size() >= 3 && data.chatId.size() <= 128
        && data.participants is list && data.participants.size() == 2
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderPhoto is string && data.senderPhoto.size() <= 500
        && data.text is string && data.text.size() <= 2000
        && data.attachmentType in ['none', 'image', 'document']
        && data.attachmentUrl is string && data.attachmentUrl.size() <= 500
        && data.attachmentName is string && data.attachmentName.size() <= 140
        && data.attachmentSize is int && data.attachmentSize >= 0 && data.attachmentSize <= 15728640
        && data.attachmentMime is string && data.attachmentMime.size() <= 120
        && data.replyToId is string && data.replyToId.size() <= 128
        && data.replyToSenderName is string && data.replyToSenderName.size() <= 80
        && data.replyToPreview is string && data.replyToPreview.size() <= 160
        && data.isDeleted is bool
        && (!('viewOnce' in data) || data.viewOnce is bool)
        && (!('viewOnceConsumed' in data) || data.viewOnceConsumed is bool)
        && (!('viewOnceOpenedAt' in data) || data.viewOnceOpenedAt == null || data.viewOnceOpenedAt is timestamp)
        && (
          data.isDeleted == true ||
          data.text.size() >= 1 ||
          (('viewOnce' in data) && data.viewOnce == true && ('viewOnceConsumed' in data) && data.viewOnceConsumed == true && data.attachmentType == 'image') ||
          (data.attachmentType in ['image', 'document'] && data.attachmentUrl.size() >= 10)
        )
        && (
          data.attachmentType == 'none' ||
          (('viewOnce' in data) && data.viewOnce == true && ('viewOnceConsumed' in data) && data.viewOnceConsumed == true && data.attachmentType == 'image' && data.attachmentUrl == '') ||
          (data.attachmentUrl.size() >= 10 && data.attachmentUrl.matches('^https://.*'))
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMchartStatus(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorPhoto', 'imageUrl', 'caption',
          'privacy', 'allowedViewerIds', 'audienceTokens', 'viewsCount',
          'createdAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhoto', 'mediaType', 'imageUrl', 'videoUrl', 'durationSec', 'caption',
          'privacy', 'allowedViewerIds', 'audienceTokens', 'viewsCount',
          'createdAt', 'expiresAt'
        ])
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && (!('mediaType' in data) || (data.mediaType is string && data.mediaType in ['image', 'video']))
        && data.imageUrl is string && data.imageUrl.size() >= 10 && data.imageUrl.size() <= 500 && data.imageUrl.matches('^https://.*')
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500 && (data.videoUrl == '' || data.videoUrl.matches('^https://.*'))))
        && (!('durationSec' in data) || (data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 300))
        && (!('mediaType' in data) || data.mediaType != 'video' || ('videoUrl' in data && data.videoUrl is string && data.videoUrl.size() >= 10 && data.videoUrl.matches('^https://.*')))
