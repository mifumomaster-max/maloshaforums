    function noteDocData(noteId) {
      return get(/databases/$(database)/documents/mchart_notes/$(noteId)).data;
    }

    function hasNoteAccessDoc(noteId) {
      return exists(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid));
    }

    function noteAccessStatus(noteId) {
      return get(/databases/$(database)/documents/mchart_notes/$(noteId)/access/$(request.auth.uid)).data.status;
    }

    function canReadProtectedNoteContent(noteId) {
      return isAdmin() || (
        isSignedIn() && (
          !('isLocked' in noteDocData(noteId)) ||
          noteDocData(noteId).isLocked != true ||
          (hasNoteAccessDoc(noteId) && noteAccessStatus(noteId) == 'unlocked') ||
          (
            ('lockedTargetMode' in noteDocData(noteId)) &&
            noteDocData(noteId).lockedTargetMode == 'selected' &&
            (!hasNoteAccessDoc(noteId) || (noteAccessStatus(noteId) != 'locked' && noteAccessStatus(noteId) != 'pending'))
          )
        )
      );
    }

