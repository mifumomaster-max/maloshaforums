    function isValidPollTournament(data, tournamentId) {
      return data.keys().hasAll([
          'tournamentId', 'title', 'description', 'institutionName', 'category', 'positionTitle',
          'targetWinnersCount', 'useGenderQuota', 'requiredMaleCount', 'requiredFemaleCount',
          'groupSize', 'roundDurationMinutes', 'status', 'currentRound', 'totalPlannedRounds',
          'candidates', 'stages', 'winnerIds',
          'createdBy', 'createdByName', 'createdByPhoto', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tournamentId', 'title', 'description', 'institutionName', 'category', 'positionTitle',
          'targetWinnersCount', 'useGenderQuota', 'requiredMaleCount', 'requiredFemaleCount',
          'groupSize', 'roundDurationMinutes', 'status', 'currentRound', 'totalPlannedRounds',
          'candidates', 'stages', 'winnerIds', 'winnerVotes',
          'createdBy', 'createdByName', 'createdByPhoto', 'createdAt', 'updatedAt'
        ])
        && data.tournamentId is string && data.tournamentId == tournamentId && isValidId(data.tournamentId)
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1500
        && data.institutionName is string && data.institutionName.size() <= 120
        && data.category in ['Siasa', 'Jamii', 'Biashara', 'Teknolojia', 'Elimu', 'Michezo', 'Uongozi', 'Mengineyo']
        && data.positionTitle is string && data.positionTitle.size() <= 80
        && data.targetWinnersCount is int && data.targetWinnersCount >= 1 && data.targetWinnersCount <= 50
        && data.useGenderQuota is bool
        && data.requiredMaleCount is int && data.requiredMaleCount >= 0 && data.requiredMaleCount <= 50
        && data.requiredFemaleCount is int && data.requiredFemaleCount >= 0 && data.requiredFemaleCount <= 50
        && data.groupSize is int && data.groupSize >= 3 && data.groupSize <= 12
        && data.roundDurationMinutes is int && data.roundDurationMinutes >= 5 && data.roundDurationMinutes <= 525600
        && data.status in ['active', 'completed']
        && data.currentRound is int && data.currentRound >= 1 && data.currentRound <= 20
        && data.totalPlannedRounds is int && data.totalPlannedRounds >= 1 && data.totalPlannedRounds <= 20
        && data.candidates is list && data.candidates.size() >= 2 && data.candidates.size() <= 300
        && data.stages is list && data.stages.size() >= 1 && data.stages.size() <= 20
        && data.winnerIds is list && data.winnerIds.size() <= 50
        && (!('winnerVotes' in data) || data.winnerVotes is map)
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80
        && data.createdByPhoto is string && data.createdByPhoto.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPollComment(data, pollId) {
      return data.keys().hasAll([
          'pollId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentCommentId', 'likesCount', 'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'pollId', 'authorId', 'authorName', 'authorPhoto', 'body',
          'parentCommentId', 'likesCount', 'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.pollId is string && isValidId(data.pollId) && data.pollId == pollId
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 4000
        && data.parentCommentId is string && data.parentCommentId.size() <= 128
        && data.likesCount is int && data.likesCount >= 0
        && data.isDeleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPollTally(data, pollId, optionId) {
      return data.keys().hasAll(['pollId', 'optionId', 'votesCount', 'updatedAt'])
        && data.keys().hasOnly(['pollId', 'optionId', 'votesCount', 'updatedAt'])
        && data.pollId is string && data.pollId == pollId && isValidId(data.pollId)
        && data.optionId is string && data.optionId == optionId && isValidId(data.optionId)
        && data.votesCount is int && data.votesCount >= 0
        && data.updatedAt is timestamp;
    }

    function isValidPollBallot(data, pollId, userId) {
      return data.keys().hasAll(['pollId', 'userId', 'voterName', 'voterPhoto', 'selectedOptionIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['pollId', 'userId', 'voterName', 'voterPhoto', 'selectedOptionIds', 'createdAt', 'updatedAt'])
        && data.pollId is string && data.pollId == pollId && isValidId(data.pollId)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.voterName is string && data.voterName.size() >= 1 && data.voterName.size() <= 80
        && data.voterPhoto is string && data.voterPhoto.size() <= 500
        && data.selectedOptionIds is list
        && data.selectedOptionIds.size() >= 1 && data.selectedOptionIds.size() <= 12
        && data.selectedOptionIds.toSet().size() == data.selectedOptionIds.size()
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function pollDocData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    function isPollOpenData(pollData) {
      return pollData.status == 'open'
        && (!pollData.hasDeadline || pollData.endsAt > request.time);
    }

    function canReadPollResultsWithData(pollId, pollData) {
      return isSignedIn() && pollData.status != 'draft' && (
        pollData.resultsVisibility == 'always' ||
        (
          pollData.resultsVisibility == 'after_close' && (
            pollData.status == 'closed' ||
            (pollData.hasDeadline && pollData.endsAt <= request.time)
          )
        ) ||
        (
          pollData.resultsVisibility == 'after_vote' && (
            exists(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid)) ||
            pollData.status == 'closed' ||
            (pollData.hasDeadline && pollData.endsAt <= request.time)
          )
        )
      );
    }

    function canReadPollResults(pollId) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/polls/$(pollId)) &&
        canReadPollResultsWithData(pollId, pollDocData(pollId))
      );
    }

    function canCreateBallotWithPoll(data, pollId, pollData) {
      return isPollOpenData(pollData)
        && data.selectedOptionIds.size() <= pollData.maxChoices
        && pollData.optionIds.hasAll(data.selectedOptionIds)
        && (pollData.questionType != 'multiple' ? data.selectedOptionIds.size() == 1 : true)
        && getAfter(/databases/$(database)/documents/polls/$(pollId)).data.totalBallots == pollData.totalBallots + 1;
    }

    function canUpdateBallotWithPoll(data, pollData) {
      return isPollOpenData(pollData)
        && pollData.allowVoteChange == true
        && data.selectedOptionIds.size() <= pollData.maxChoices
        && pollData.optionIds.hasAll(data.selectedOptionIds)
        && (pollData.questionType != 'multiple' ? data.selectedOptionIds.size() == 1 : true);
    }

    function canCreateCommentWithPoll(pollId, pollData) {
      return isPollOpenData(pollData)
        && (!('allowComments' in pollData) || pollData.allowComments == true)
        && (
          (
            !('commentsCount' in pollData) &&
            getAfter(/databases/$(database)/documents/polls/$(pollId)).data.commentsCount == 1
          ) ||
          (
            'commentsCount' in pollData &&
            getAfter(/databases/$(database)/documents/polls/$(pollId)).data.commentsCount == pollData.commentsCount + 1
          )
        );
    }

    function canChangeExistingTallyWithBallots(optionId, beforeBallotData, afterBallotData) {
      return (
        incoming().votesCount == existing().votesCount + 1
        && optionId in afterBallotData.selectedOptionIds
        && !(optionId in beforeBallotData.selectedOptionIds)
      ) || (
        existing().votesCount >= 1
        && incoming().votesCount == existing().votesCount - 1
        && optionId in beforeBallotData.selectedOptionIds
        && !(optionId in afterBallotData.selectedOptionIds)
      );
    }

    function canVoterSyncTallyWithBatch(pollId, optionId, afterBallotData) {
      return afterBallotData.updatedAt == request.time
        && afterBallotData.pollId == pollId
        && afterBallotData.userId == request.auth.uid
        && (
          (
            !exists(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid))
            && incoming().votesCount == existing().votesCount + 1
            && optionId in afterBallotData.selectedOptionIds
          ) ||
          (
            exists(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid))
            && canChangeExistingTallyWithBallots(
              optionId,
              get(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid)).data,
              afterBallotData
            )
          )
        );
    }

    // 4. Admins Collection
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // 5. Public User Profiles + Isolated PII Subcollection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'member' || isAdmin())
        && (!('verificationBadge' in incoming()) || incoming().verificationBadge == 'none' || isAdmin())
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active' || isAdmin())
        && (!('suspendedReason' in incoming()) || incoming().suspendedReason == '' || isAdmin())
        && (!('suspendedRuleNumber' in incoming()) || incoming().suspendedRuleNumber == 0 || isAdmin())
        && incoming().topicsCount == 0
        && incoming().repliesCount == 0
        && (!('followersCount' in incoming()) || incoming().followersCount == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            (!('accountStatus' in existing()) || existing().accountStatus != 'suspended') &&
            incoming().role == existing().role &&
            (
              (!('verificationBadge' in incoming()) && !('verificationBadge' in existing())) ||
              ('verificationBadge' in existing() && 'verificationBadge' in incoming() && incoming().verificationBadge == existing().verificationBadge) ||
              (!('verificationBadge' in existing()) && 'verificationBadge' in incoming() && incoming().verificationBadge == 'none')
            ) &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt']) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['topicsCount', 'updatedAt']) &&
                (incoming().topicsCount == existing().topicsCount + 1 || incoming().topicsCount == existing().topicsCount - 1)
              ) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'updatedAt']) &&
                (incoming().repliesCount == existing().repliesCount + 1 || incoming().repliesCount == existing().repliesCount - 1)
              )
            )
          ) ||
          (
            isNotSuspended() &&
            request.auth.uid != userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) &&
            incoming().followersCount is int &&
            incoming().followersCount >= 0 &&
            (
              (
                (
                  (!('followersCount' in existing()) && incoming().followersCount == 1) ||
                  ('followersCount' in existing() && incoming().followersCount == existing().followersCount + 1)
                ) &&
                !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              ) ||
              (
                'followersCount' in existing() &&
                existing().followersCount >= 1 &&
                incoming().followersCount == existing().followersCount - 1 &&
                exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)) &&
                !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isNotSuspended()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'updatedAt']);

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && docId == 'info';
      }

      match /notifications/{notificationId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(notificationId)
          && (isOwner(userId) || isAdmin());

        allow list: if isSignedIn()
          && (resource.data.recipientId == request.auth.uid || isAdmin());

        allow create: if isNotSuspended()
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidUserNotification(incoming(), userId)
          && incoming().actorId == request.auth.uid
          && incoming().isRead == false
          && incoming().createdAt == request.time
          && (
            (
              incoming().type in ['comment_reply', 'post_comment'] &&
              incoming().recipientId != request.auth.uid &&
              exists(/databases/$(database)/documents/topics/$(incoming().topicId))
            ) ||
            (
              isAdmin() &&
              incoming().type in ['account_moderation', 'video_moderation', 'post_moderation']
            )
          );

        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidUserNotification(incoming(), userId)
          && isOwner(userId)
          && incoming().recipientId == existing().recipientId
          && incoming().actorId == existing().actorId
          && incoming().topicId == existing().topicId
          && incoming().replyId == existing().replyId
          && incoming().createdAt == existing().createdAt
          && (!('readAt' in incoming()) || incoming().readAt == null || incoming().readAt == request.time)
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt']);

        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(notificationId)
          && (isOwner(userId) || isAdmin());
      }

      match /followers/{followerId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(followerId);
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin() || resource.data.followerId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(userId)
          && isValidId(followerId)
          && followerId == request.auth.uid
          && userId != request.auth.uid
          && isValidUserFollower(incoming(), followerId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isNotSuspended()
          && isValidId(userId)
          && isValidId(followerId)
          && (followerId == request.auth.uid || isAdmin());
      }
    }

    // 6. Forum Topics & Subcollections
    match /topics/{topicId} {
      allow get: if isValidId(topicId)
        && (existing().status in ['open', 'locked'] || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

      allow list: if resource.data.status in ['open', 'locked']
        || isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(topicId)
        && isValidTopic(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open'
        && (incoming().isPinned == false || isAdmin())
        && incoming().repliesCount == 0
        && incoming().upvotesCount == 0
        && incoming().acceptedReplyId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastActivityAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(topicId)
        && isValidTopic(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (existing().status != 'archived' || isAdmin())
        && (
          // Action 1: Admin Moderation
          (
            isAdmin() &&
            incoming().updatedAt == request.time
          ) ||
          // Action 2: Author Content Edit
          (
            existing().authorId == request.auth.uid &&
            existing().status == 'open' &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'category', 'tags',
              'company', 'location', 'jobType', 'deadline', 'applyInfo', 'coverImage',
              'updatedAt'
            ])
          ) ||
          // Action 3: Author Lock / Archive
          (
            existing().authorId == request.auth.uid &&
            existing().status in ['open', 'locked'] &&
            incoming().status in ['open', 'locked', 'archived'] &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 4: Author Accepts Best Reply
          (
            existing().authorId == request.auth.uid &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['acceptedReplyId', 'updatedAt'])
          ) ||
          // Action 5: Reply Activity Counter Sync
          (
            existing().status == 'open' &&
            incoming().updatedAt == request.time &&
            incoming().lastActivityAt == request.time &&
            (incoming().repliesCount == existing().repliesCount + 1 || incoming().repliesCount == existing().repliesCount - 1) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'lastActivityAt', 'updatedAt'])
          ) ||
          // Action 6: Atomic Upvote Sync
          (
            existing().status in ['open', 'locked'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount']) &&
            (
              (
                incoming().upvotesCount == existing().upvotesCount + 1 &&
                !exists(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid))
              ) ||
              (
                incoming().upvotesCount == existing().upvotesCount - 1 &&
                exists(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid)) &&
                !existsAfter(/databases/$(database)/documents/topics/$(topicId)/votes/$(request.auth.uid))
              )
            )
          )
        );

      allow delete: if isSignedIn()
        && isValidId(topicId)
        && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

      // Topic Votes
      match /votes/{userId} {
        allow get: if isSignedIn() && isValidId(topicId) && isValidId(userId) && (userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidVote(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/topics/$(topicId));

        allow update: if false;
        allow delete: if isValidId(topicId) && isValidId(userId) && (isAdmin() || (isNotSuspended() && userId == request.auth.uid));
      }

      // Topic Replies Subcollection
      match /replies/{replyId} {
        allow get: if isValidId(topicId)
          && isValidId(replyId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(replyId)
          && isValidReply(incoming(), topicId)
          && incoming().authorId == request.auth.uid
          && incoming().isAcceptedAnswer == false
          && incoming().upvotesCount == 0
          && incoming().isDeleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/topics/$(topicId))
          && get(/databases/$(database)/documents/topics/$(topicId)).data.status == 'open'
          && getAfter(/databases/$(database)/documents/topics/$(topicId)).data.repliesCount ==
             get(/databases/$(database)/documents/topics/$(topicId)).data.repliesCount + 1;

        allow update: if isNotSuspended()
          && isValidId(topicId)
          && isValidId(replyId)
          && isValidReply(incoming(), topicId)
          && incoming().topicId == existing().topicId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && (
            // Action 1: Admin Moderation
            (
              isAdmin() &&
              incoming().updatedAt == request.time
            ) ||
            // Action 2: Author Reply Edit
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              get(/databases/$(database)/documents/topics/$(topicId)).data.status == 'open' &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt'])
            ) ||
            // Action 3: Author Soft Delete
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              incoming().isDeleted == true &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'body', 'updatedAt'])
            ) ||
            // Action 4: Topic Author Accepts / Unaccepts Reply
            (
              get(/databases/$(database)/documents/topics/$(topicId)).data.authorId == request.auth.uid &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isAcceptedAnswer', 'updatedAt'])
            ) ||
            // Action 5: Atomic Reply Upvote Sync
            (
              existing().isDeleted == false &&
              incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount']) &&
              (
                (
                  incoming().upvotesCount == existing().upvotesCount + 1 &&
                  !exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid)) &&
                  existsAfter(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid))
                ) ||
                (
                  incoming().upvotesCount == existing().upvotesCount - 1 &&
                  exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid)) &&
                  !existsAfter(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId)/votes/$(request.auth.uid))
                )
              )
            )
          );

        allow delete: if isSignedIn()
          && isValidId(topicId)
          && isValidId(replyId)
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

        // Reply Votes
        match /votes/{userId} {
          allow get: if isSignedIn() && isValidId(topicId) && isValidId(replyId) && isValidId(userId) && (userId == request.auth.uid || isAdmin());
          allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

          allow create: if isNotSuspended()
            && isValidId(topicId)
            && isValidId(replyId)
            && isValidId(userId)
            && userId == request.auth.uid
            && isValidVote(incoming(), userId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/topics/$(topicId)/replies/$(replyId));

          allow update: if false;
          allow delete: if isValidId(topicId) && isValidId(replyId) && isValidId(userId) && (isAdmin() || (isNotSuspended() && userId == request.auth.uid));
        }
      }
    }

    // 7. Moderation Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (isAdmin() || existing().reporterId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && (
          (
            incoming().targetType in ['topic', 'reply'] &&
            exists(/databases/$(database)/documents/topics/$(incoming().topicId))
          ) ||
          (
            incoming().targetType == 'video' &&
            exists(/databases/$(database)/documents/videos/$(incoming().targetId))
          )
        );

      allow update: if isAdmin()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // 8. Community Group Chat Messages (Strictly Authenticated Members Only)
    match /forum_chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId);
      allow list: if isSignedIn() && (
        (resource.data.createdAt >= timestamp.date(1970, 1, 1) && request.query.limit <= 200)
        || isAdmin()
        || resource.data.senderId == request.auth.uid
      );

      allow create: if isNotSuspended()
        && isValidId(messageId)
        && isValidChatMessage(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().isDeleted == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(messageId)
        && isValidChatMessage(incoming())
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().senderId == request.auth.uid &&
            existing().isDeleted == false &&
            incoming().isDeleted == true &&
            incoming().attachmentType == 'none' &&
            incoming().attachmentUrl == '' &&
            incoming().attachmentName == '' &&
            incoming().attachmentSize == 0 &&
            incoming().attachmentMime == ''
          )
        );

      allow delete: if isSignedIn()
        && isValidId(messageId)
        && (isAdmin() || (isNotSuspended() && existing().senderId == request.auth.uid));
    }

    // 9. Owner Mchart Notes & Archive Files (Strictly Authenticated Members Only)
    match /mchart_notes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId);
      allow list: if isSignedIn() && (
        (resource.data.createdAt >= timestamp.date(1970, 1, 1) && request.query.limit <= 100)
        || isAdmin()
      );

      allow create: if isAdmin()
        && isValidId(noteId)
        && isValidMchartNote(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(noteId)
        && isValidMchartNote(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(noteId);

      // Protected Full Body & PDF URL for Paid / Locked Notes
      match /content/{docId} {
        allow get: if isValidId(noteId)
          && docId == 'full'
          && canReadProtectedNoteContent(noteId);
        allow list: if false;

        allow create, update: if isAdmin()
          && isValidId(noteId)
          && docId == 'full'
          && isValidNoteProtectedContent(incoming(), noteId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/mchart_notes/$(noteId));

        allow delete: if isAdmin() && isValidId(noteId) && docId == 'full';
      }

      // Per-User Payment Unlock & Targeted Lock Records
      match /access/{userId} {
        allow get: if isValidId(noteId) && isValidId(userId) && (isAdmin() || isOwner(userId));
        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

        allow create: if isSignedIn()
          && isValidId(noteId)
          && isValidId(userId)
          && isValidNoteAccess(incoming(), noteId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/mchart_notes/$(noteId))
          && (
            isAdmin() ||
            (
              isNotSuspended() &&
              isOwner(userId) &&
              incoming().status == 'pending'
            )
          );

        allow update: if isSignedIn()
          && isValidId(noteId)
          && isValidId(userId)
          && isValidNoteAccess(incoming(), noteId, userId)
          && incoming().noteId == existing().noteId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isNotSuspended() &&
              isOwner(userId) &&
              existing().status != 'unlocked' &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'userName', 'paymentReference', 'updatedAt'])
            )
          );

        allow delete: if isAdmin() && isValidId(noteId) && isValidId(userId);
      }
    }

    // 10. Official Member ID Registry (Zero PII — For Authenticity Verification)
    match /member_ids/{cardId} {
      allow get: if isValidId(cardId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(cardId)
        && isValidMemberIdRecord(incoming(), cardId)
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(incoming().uid) &&
            isNotSuspended() &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            incoming().role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
            incoming().accountStatus == 'active' &&
            (
              (!('verificationBadge' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) && incoming().verificationBadge == 'none') ||
              incoming().verificationBadge == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationBadge
            )
          )
        );

      allow update: if isSignedIn()
        && isValidId(cardId)
        && isValidMemberIdRecord(incoming(), cardId)
        && incoming().cardNumber == existing().cardNumber
        && incoming().controlSerial == existing().controlSerial
        && incoming().uid == existing().uid
        && incoming().issuedAt == existing().issuedAt
        && incoming().expiresAt == existing().expiresAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().uid) &&
            isNotSuspended() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(cardId);
    }

    // 10B. Zero-PII Active Member Directory (Alphabetical A-Z Private Chat Discovery)
    match /member_directory/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isActive == true;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidMemberDirectoryEntry(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            isNotSuspended() &&
            incoming().isActive == true &&
            (
              incoming().verificationBadge == 'none' ||
              (
                exists(/databases/$(database)/documents/users/$(userId)) &&
                'verificationBadge' in get(/databases/$(database)/documents/users/$(userId)).data &&
                incoming().verificationBadge == get(/databases/$(database)/documents/users/$(userId)).data.verificationBadge
              )
            )
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidMemberDirectoryEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            isNotSuspended() &&
            incoming().isActive == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'verificationBadge', 'isActive', 'updatedAt']) &&
            (
              incoming().verificationBadge == existing().verificationBadge ||
              (
                exists(/databases/$(database)/documents/users/$(userId)) &&
                'verificationBadge' in get(/databases/$(database)/documents/users/$(userId)).data &&
                incoming().verificationBadge == get(/databases/$(database)/documents/users/$(userId)).data.verificationBadge
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 11. Real-Time Online Presence & Mchart Typing State (Zero PII)
    match /user_presence/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.isOnline == true || isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPresence(incoming(), userId)
        && incoming().lastSeenAt == request.time
        && incoming().typingUpdatedAt == request.time
        && incoming().updatedAt == request.time
        && (isNotSuspended() || (incoming().isOnline == false && incoming().isTypingInMchart == false));

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPresence(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().lastSeenAt == request.time
        && incoming().typingUpdatedAt == request.time
        && incoming().updatedAt == request.time
        && (isNotSuspended() || (incoming().isOnline == false && incoming().isTypingInMchart == false));

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 12. Private 1-on-1 Direct Chats (Strictly Participant-Only — Zero Admin Override)
    match /direct_chats/{chatId} {
      allow get: if isSignedIn()
        && isValidId(chatId)
        && request.auth.uid in existing().participants;

      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isNotSuspended()
        && isValidId(chatId)
        && isValidDirectChat(incoming(), chatId)
        && (request.auth.uid == incoming().participantA || request.auth.uid == incoming().participantB)
        && incoming().unreadCountA == 0
        && incoming().unreadCountB == 0
        && incoming().lastMessageAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(chatId)
        && isValidDirectChat(incoming(), chatId)
        && request.auth.uid in existing().participants
        && incoming().chatId == existing().chatId
        && incoming().participantA == existing().participantA
        && incoming().participantB == existing().participantB
        && incoming().participants == existing().participants
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().lastSenderId == existing().lastSenderId || incoming().lastSenderId == request.auth.uid);

      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && request.auth.uid in existing().participants;

        allow list: if isSignedIn()
          && request.auth.uid in resource.data.participants;

        allow create: if isNotSuspended()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidDirectMessage(incoming(), chatId)
          && incoming().senderId == request.auth.uid
          && request.auth.uid in incoming().participants
          && exists(/databases/$(database)/documents/direct_chats/$(chatId))
          && incoming().participants == get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants
          && incoming().isDeleted == false
          && (!('viewOnceConsumed' in incoming()) || incoming().viewOnceConsumed == false)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isNotSuspended()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidDirectMessage(incoming(), chatId)
          && incoming().senderId == existing().senderId
          && incoming().chatId == existing().chatId
          && incoming().participants == existing().participants
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().isDeleted == false
          && (
            (
              existing().senderId == request.auth.uid
              && incoming().isDeleted == true
              && incoming().attachmentType == 'none'
              && incoming().attachmentUrl == ''
              && incoming().attachmentName == ''
              && incoming().attachmentSize == 0
              && incoming().attachmentMime == ''
            ) ||
            (
              request.auth.uid in existing().participants
              && existing().senderId != request.auth.uid
              && ('viewOnce' in existing()) && existing().viewOnce == true
              && (!('viewOnceConsumed' in existing()) || existing().viewOnceConsumed == false)
              && incoming().viewOnce == true
              && incoming().viewOnceConsumed == true
              && incoming().viewOnceOpenedAt == request.time
              && incoming().attachmentType == existing().attachmentType
              && incoming().attachmentUrl == ''
              && incoming().diff(existing()).affectedKeys().hasOnly(['viewOnceConsumed', 'viewOnceOpenedAt', 'attachmentUrl', 'updatedAt'])
            )
          );

        allow delete: if isNotSuspended()
          && isValidId(chatId)
          && isValidId(messageId)
          && existing().senderId == request.auth.uid;
      }
    }

    // 13. WhatsApp-Style 24h Photo Statuses (Authenticated Members Only + Audience Privacy)
    match /mchart_statuses/{statusId} {
      allow get: if isValidId(statusId)
        && isSignedIn()
        && (
          existing().authorId == request.auth.uid ||
          (
            existing().expiresAt > request.time &&
            (
              (existing().privacy == 'members' && '__MEMBERS__' in existing().audienceTokens) ||
              request.auth.uid in existing().audienceTokens
            )
          )
        );

      allow list: if isSignedIn()
        && (
          '__MEMBERS__' in resource.data.audienceTokens ||
          request.auth.uid in resource.data.audienceTokens ||
          resource.data.authorId == request.auth.uid
        );

      allow create: if isNotSuspended()
        && isValidId(statusId)
        && isValidMchartStatus(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time
        && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(26, 'h');

      allow update: if isSignedIn()
        && isValidId(statusId)
        && isValidMchartStatus(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt
        && (
          (
            isNotSuspended()
            && existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'privacy', 'allowedViewerIds', 'audienceTokens'])
          ) ||
          (
            isNotSuspended()
            && existing().expiresAt > request.time
            && (
              '__MEMBERS__' in existing().audienceTokens ||
              request.auth.uid in existing().audienceTokens
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
            && incoming().viewsCount == existing().viewsCount + 1
            && existsAfter(/databases/$(database)/documents/mchart_statuses/$(statusId)/views/$(request.auth.uid))
          )
        );

      allow delete: if isSignedIn()
        && isValidId(statusId)
        && (existing().authorId == request.auth.uid || isAdmin());

      match /views/{viewerId} {
        allow get: if isSignedIn()
          && isValidId(statusId)
          && isValidId(viewerId)
          && (viewerId == request.auth.uid || existing().statusAuthorId == request.auth.uid);

        allow list: if isSignedIn()
          && resource.data.statusAuthorId == request.auth.uid;

        allow create: if isNotSuspended()
          && isValidId(statusId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && isValidMchartStatusView(incoming(), statusId, viewerId)
          && incoming().viewedAt == request.time
          && exists(/databases/$(database)/documents/mchart_statuses/$(statusId))
          && incoming().statusAuthorId == get(/databases/$(database)/documents/mchart_statuses/$(statusId)).data.authorId
          && get(/databases/$(database)/documents/mchart_statuses/$(statusId)).data.expiresAt > request.time
          && (
            (get(/databases/$(database)/documents/mchart_statuses/$(statusId)).data.privacy == 'members' &&
             '__MEMBERS__' in get(/databases/$(database)/documents/mchart_statuses/$(statusId)).data.audienceTokens) ||
            request.auth.uid in get(/databases/$(database)/documents/mchart_statuses/$(statusId)).data.audienceTokens
          );

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(statusId)
          && isValidId(viewerId)
          && (existing().statusAuthorId == request.auth.uid || isAdmin());
      }
    }

    // 14. TikTok-Style Cloudinary Videos & Subcollections
    match /videos/{videoId} {
      allow get: if isValidId(videoId)
        && (existing().isArchived == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

      allow list: if resource.data.isArchived == false
        || isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isNotSuspended()
        && isValidId(videoId)
        && isValidVideo(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().isArchived == false
        && !('moderationRuleNumber' in incoming())
        && !('moderationReason' in incoming())
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().sharesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isNotSuspended()
        && isValidId(videoId)
        && isValidVideo(incoming())
        && incoming().authorId == existing().authorId
        && incoming().videoUrl == existing().videoUrl
        && incoming().cloudinaryPublicId == existing().cloudinaryPublicId
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Admin Moderation
          (
            isAdmin() &&
            incoming().updatedAt == request.time
          ) ||
          // Action 2: Author Caption / Sound / Settings / Archive Update
          (
            existing().authorId == request.auth.uid &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'caption', 'soundName', 'tags', 'isArchived',
              'allowComments', 'allowDownload', 'allowLikes', 'showLikeCount',
              'autoReplyEnabled', 'autoReplyMessage', 'autoReplyTrigger', 'autoReplyKeyword',
              'updatedAt'
            ])
          ) ||
          // Action 3: Atomic Like Counter Sync
          (
            existing().isArchived == false &&
            (!('allowLikes' in existing()) || existing().allowLikes != false) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
            (
              (
                incoming().likesCount == existing().likesCount + 1 &&
                !exists(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid))
              ) ||
              (
                incoming().likesCount == existing().likesCount - 1 &&
                exists(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid)) &&
                !existsAfter(/databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid))
              )
            )
          ) ||
          // Action 4: Comment Counter Sync (supports +1 user comment or +2 with verified auto-reply)
          (
            existing().isArchived == false &&
            incoming().updatedAt == request.time &&
            (
              incoming().commentsCount == existing().commentsCount + 1 ||
              (
                incoming().commentsCount == existing().commentsCount + 2 &&
                'autoReplyEnabled' in existing() &&
                existing().autoReplyEnabled == true
              ) ||
              incoming().commentsCount == existing().commentsCount - 1
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
          ) ||
          // Action 5: Share Counter Increment
          (
            existing().isArchived == false &&
            incoming().sharesCount == existing().sharesCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(videoId)
        && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(userId) && (userId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isNotSuspended()
          && isValidId(videoId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidVote(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/videos/$(videoId))
          && (!('allowLikes' in get(/databases/$(database)/documents/videos/$(videoId)).data) || get(/databases/$(database)/documents/videos/$(videoId)).data.allowLikes != false);

        allow update: if false;

        allow delete: if isValidId(videoId)
          && isValidId(userId)
          && (isAdmin() || (isNotSuspended() && userId == request.auth.uid));
      }

      match /comments/{commentId} {
        allow get: if isValidId(videoId)
          && isValidId(commentId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidVideoComment(incoming(), videoId)
          && incoming().isDeleted == false
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/videos/$(videoId))
          && get(/databases/$(database)/documents/videos/$(videoId)).data.isArchived == false
          && (
            !('allowComments' in get(/databases/$(database)/documents/videos/$(videoId)).data) ||
            get(/databases/$(database)/documents/videos/$(videoId)).data.allowComments != false ||
            get(/databases/$(database)/documents/videos/$(videoId)).data.authorId == request.auth.uid ||
            isAdmin()
          )
          && (
            (
              incoming().authorId == request.auth.uid &&
              (!('isAutoReply' in incoming()) || incoming().isAutoReply == false)
            ) ||
            (
              'isAutoReply' in incoming() &&
              incoming().isAutoReply == true &&
              'autoReplyEnabled' in get(/databases/$(database)/documents/videos/$(videoId)).data &&
              get(/databases/$(database)/documents/videos/$(videoId)).data.autoReplyEnabled == true &&
              'autoReplyMessage' in get(/databases/$(database)/documents/videos/$(videoId)).data &&
              get(/databases/$(database)/documents/videos/$(videoId)).data.autoReplyMessage.size() >= 1 &&
              incoming().authorId == get(/databases/$(database)/documents/videos/$(videoId)).data.authorId &&
              incoming().body == get(/databases/$(database)/documents/videos/$(videoId)).data.autoReplyMessage
            )
          )
          && (
            getAfter(/databases/$(database)/documents/videos/$(videoId)).data.commentsCount ==
               get(/databases/$(database)/documents/videos/$(videoId)).data.commentsCount + 1 ||
            (
              getAfter(/databases/$(database)/documents/videos/$(videoId)).data.commentsCount ==
                 get(/databases/$(database)/documents/videos/$(videoId)).data.commentsCount + 2 &&
              'autoReplyEnabled' in get(/databases/$(database)/documents/videos/$(videoId)).data &&
              get(/databases/$(database)/documents/videos/$(videoId)).data.autoReplyEnabled == true
            )
          );

        allow update: if isSignedIn()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidVideoComment(incoming(), videoId)
          && incoming().videoId == existing().videoId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid))
          && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted']);

        allow delete: if isSignedIn()
          && isValidId(videoId)
          && isValidId(commentId)
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));
      }
    }

    // 15. Owner-Controlled Navigation & Retention Settings
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'navigation' || (settingId == 'retention' && isAdmin()));
      allow list: if false;

      allow create, update: if isAdmin()
        && isValidId(settingId)
        && (
          (settingId == 'navigation' && isValidSiteNavSettings(incoming())) ||
          (settingId == 'retention' && isValidContentRetentionSettings(incoming()))
        )
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin()
        && isValidId(settingId)
        && (settingId == 'navigation' || settingId == 'retention');
    }

    // 16. Owner-Only Editable Specimen Identity Cards
    match /owner_id_cards/{cardId} {
      allow get: if isAdmin() && isValidId(cardId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(cardId)
        && isValidOwnerCustomIdCard(incoming(), cardId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(cardId)
        && isValidOwnerCustomIdCard(incoming(), cardId)
        && incoming().cardId == existing().cardId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(cardId);
    }

    // 17. Owner-Issued Institutional Training Certificates (A4)
    match /training_certificates/{certId} {
      allow get: if isAdmin() && isValidId(certId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(certId)
        && isValidTrainingCertificate(incoming(), certId)
        && incoming().issuerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(certId)
        && isValidTrainingCertificate(incoming(), certId)
        && incoming().certId == existing().certId
        && incoming().issuerUid == existing().issuerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(certId);
    }

    // 18. Owner-Only Private Personal Photo Vault Backup
    match /owner_private_photos/{photoId} {
      allow get: if isAdmin() && isValidId(photoId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(photoId)
        && isValidOwnerPrivatePhoto(incoming(), photoId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(photoId)
        && isValidOwnerPrivatePhoto(incoming(), photoId)
        && incoming().photoId == existing().photoId
        && incoming().ownerUid == existing().ownerUid
        && incoming().fileHash == existing().fileHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(photoId);
    }

    // 18B. Owner-Only Hierarchical Photo Folders with Optional SHA-256 PIN Lock
    match /owner_photo_folders/{folderId} {
      allow get: if isAdmin() && isValidId(folderId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(folderId)
        && isValidOwnerPhotoFolder(incoming(), folderId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(folderId)
        && isValidOwnerPhotoFolder(incoming(), folderId)
        && incoming().folderId == existing().folderId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(folderId);
    }

    // 19. Community Polls & Voting (Owner-Managed Questions + 1-Per-Account Secure Ballots)
    match /polls/{pollId} {
      allow get: if isValidId(pollId)
        && (existing().status in ['open', 'closed'] || isAdmin());

      allow list: if resource.data.status in ['open', 'closed'] || isAdmin();

      allow create: if isAdmin()
        && isValidId(pollId)
        && isValidPoll(incoming(), pollId)
        && incoming().createdBy == request.auth.uid
        && incoming().totalBallots == 0
        && (!('commentsCount' in incoming()) || incoming().commentsCount == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(pollId)
        && incoming().pollId == existing().pollId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && isValidPoll(incoming(), pollId)) ||
          (
            isNotSuspended()
            && isPollOpenData(existing())
            && incoming().diff(existing()).affectedKeys().hasOnly(['totalBallots', 'updatedAt'])
            && incoming().totalBallots is int
            && incoming().totalBallots == existing().totalBallots + 1
            && !exists(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid))
          ) ||
          (
            isNotSuspended()
            && isPollOpenData(existing())
            && (!('allowComments' in existing()) || existing().allowComments == true)
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount is int
            && incoming().commentsCount >= 0
            && (
              (
                (!('commentsCount' in existing()) && incoming().commentsCount == 1) ||
                ('commentsCount' in existing() && incoming().commentsCount == existing().commentsCount + 1)
              ) ||
              (
                'commentsCount' in existing()
                && existing().commentsCount >= 1
                && incoming().commentsCount == existing().commentsCount - 1
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(pollId);

      match /tallies/{optionId} {
        allow get: if isValidId(pollId) && isValidId(optionId) && canReadPollResults(pollId);

        allow list: if isAdmin();

        allow create: if isAdmin()
          && isValidId(pollId)
          && isValidId(optionId)
          && isValidPollTally(incoming(), pollId, optionId)
          && incoming().votesCount == 0
          && incoming().updatedAt == request.time;

        allow update: if isValidId(pollId)
          && isValidId(optionId)
          && isValidPollTally(incoming(), pollId, optionId)
          && incoming().pollId == existing().pollId
          && incoming().optionId == existing().optionId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isSignedIn()
              && incoming().diff(existing()).affectedKeys().hasOnly(['votesCount', 'updatedAt'])
              && existsAfter(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid))
              && canVoterSyncTallyWithBatch(
                pollId,
                optionId,
                getAfter(/databases/$(database)/documents/polls/$(pollId)/ballots/$(request.auth.uid)).data
              )
            )
          );

        allow delete: if isAdmin() && isValidId(pollId) && isValidId(optionId);
      }

      match /ballots/{userId} {
        allow get: if isSignedIn()
          && isValidId(pollId)
          && isValidId(userId)
          && (isOwner(userId) || isAdmin());

        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(pollId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidPollBallot(incoming(), pollId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/polls/$(pollId))
          && canCreateBallotWithPoll(incoming(), pollId, pollDocData(pollId));

        allow update: if isNotSuspended()
          && isValidId(pollId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidPollBallot(incoming(), pollId, userId)
          && incoming().pollId == existing().pollId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/polls/$(pollId))
          && canUpdateBallotWithPoll(incoming(), pollDocData(pollId));

        allow delete: if isAdmin() && isValidId(pollId) && isValidId(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(pollId)
          && isValidId(commentId)
          && (existing().isDeleted == false || isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));

        allow list: if resource.data.isDeleted == false
          || isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);

        allow create: if isNotSuspended()
          && isValidId(pollId)
          && isValidId(commentId)
          && isValidPollComment(incoming(), pollId)
          && incoming().authorId == request.auth.uid
          && incoming().likesCount == 0
          && incoming().isDeleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/polls/$(pollId))
          && canCreateCommentWithPoll(pollId, pollDocData(pollId));

        allow update: if isNotSuspended()
          && isValidId(pollId)
          && isValidId(commentId)
          && isValidPollComment(incoming(), pollId)
          && incoming().pollId == existing().pollId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && (
            // Action 1: Admin Moderation
            (
              isAdmin() &&
              incoming().updatedAt == request.time
            ) ||
            // Action 2: Author Comment Edit
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              isPollOpenData(pollDocData(pollId)) &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt'])
            ) ||
            // Action 3: Author Soft Delete
            (
              existing().authorId == request.auth.uid &&
              existing().isDeleted == false &&
              incoming().isDeleted == true &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'body', 'updatedAt'])
            ) ||
            // Action 4: Atomic Comment Like Sync
            (
              existing().isDeleted == false &&
              incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
              (
                (
                  incoming().likesCount == existing().likesCount + 1 &&
                  !exists(/databases/$(database)/documents/polls/$(pollId)/comments/$(commentId)/likes/$(request.auth.uid)) &&
                  existsAfter(/databases/$(database)/documents/polls/$(pollId)/comments/$(commentId)/likes/$(request.auth.uid))
                ) ||
                (
                  existing().likesCount >= 1 &&
                  incoming().likesCount == existing().likesCount - 1 &&
                  exists(/databases/$(database)/documents/polls/$(pollId)/comments/$(commentId)/likes/$(request.auth.uid)) &&
                  !existsAfter(/databases/$(database)/documents/polls/$(pollId)/comments/$(commentId)/likes/$(request.auth.uid))
                )
              )
            )
          );

        allow delete: if isSignedIn()
          && isValidId(pollId)
          && isValidId(commentId)
          && (isAdmin() || (isNotSuspended() && existing().authorId == request.auth.uid));

        match /likes/{userId} {
          allow get: if isSignedIn()
            && isValidId(pollId)
            && isValidId(commentId)
            && isValidId(userId)
            && (userId == request.auth.uid || isAdmin());

          allow list: if isSignedIn()
            && (resource.data.userId == request.auth.uid || isAdmin());

          allow create: if isNotSuspended()
            && isValidId(pollId)
            && isValidId(commentId)
            && isValidId(userId)
            && userId == request.auth.uid
            && isValidVote(incoming(), userId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/polls/$(pollId)/comments/$(commentId));

          allow update: if false;

          allow delete: if isSignedIn()
            && isValidId(pollId)
            && isValidId(commentId)
            && isValidId(userId)
            && (isAdmin() || (isNotSuspended() && userId == request.auth.uid));
        }
      }
    }

    // 20. Multi-Stage Deterministic Elimination Tournaments (Mchakato wa Mtoano)
    match /poll_tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(tournamentId)
        && isValidPollTournament(incoming(), tournamentId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(tournamentId)
        && isValidPollTournament(incoming(), tournamentId)
        && incoming().tournamentId == existing().tournamentId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(tournamentId);
    }
  }
}
