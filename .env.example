# CLOUDINARY: Optional image upload configuration for Kijiweni posts.
# Create an unsigned upload preset in your Cloudinary dashboard and set both variables.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# PLATFORM LOCK UNLOCK EMAIL (Server-side in server.ts — optional; falls back to mailto: if unset):
# Option A: Resend HTTPS API (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM=""

# Option B: Standard SMTP or Gmail App Password (nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

