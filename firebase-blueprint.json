{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public forum member profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["member", "moderator"] },
        "verificationBadge": {
          "type": "string",
          "enum": ["none", "individual", "organization", "government", "owner", "journalist", "educator", "creator"],
          "description": "Account verification tier assigned by platform administrators (7 verified colors + none)."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account moderation state; suspended accounts cannot perform any actions."
        },
        "suspendedReason": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional reason shown when an account is suspended by the platform owner."
        },
        "suspendedRuleNumber": {
          "type": "integer",
          "description": "Community rule number (1-13) violated when suspended."
        },
        "topicsCount": { "type": "integer" },
        "repliesCount": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "bio", "role", "topicsCount", "repliesCount", "createdAt", "updatedAt"]
    },
    "UserFollower": {
      "title": "UserFollower",
      "description": "Record of a forum member following another member.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "followerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "followerPhoto": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followerName", "followerPhoto", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private user account information (PII isolated from public reads).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Topic": {
      "title": "Topic",
      "description": "A discussion topic posted by a verified forum member.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 0, "maxLength": 140, "description": "Required >= 5 chars unless posting an image-only Kijiweni post." },
        "body": { "type": "string", "minLength": 0, "maxLength": 8000, "description": "Required >= 10 chars unless posting an image-only Kijiweni post." },
        "category": {
          "type": "string",
          "enum": [
            "Kijiweni", "Fursa", "Makala",
            "Habari na Hoja", "Jukwaa la Siasa", "Jamii Intelligence",
            "Biashara & Uchumi", "Mahusiano (MMU)", "Teknolojia & Sayansi",
            "Elimu & Ajira", "Michezo & Burudani",
            "Teknolojia", "Biashara", "Elimu", "Jamii", "Sayansi", "Michezo"
          ]
        },
        "tags": { "type": "array", "description": "Up to 5 short topic tags." },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "locked", "archived"] },
        "isPinned": { "type": "boolean" },
        "repliesCount": { "type": "integer" },
        "upvotesCount": { "type": "integer" },
        "acceptedReplyId": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "jobType": { "type": "string", "maxLength": 40 },
        "deadline": { "type": "string", "maxLength": 60 },
        "applyInfo": { "type": "string", "maxLength": 300 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastActivityAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "body", "category", "tags", "authorId", "authorName", "authorPhoto",
        "status", "isPinned", "repliesCount", "upvotesCount", "acceptedReplyId",
        "createdAt", "updatedAt", "lastActivityAt"
      ]
    },
    "Reply": {
      "title": "Reply",
      "description": "A reply inside a discussion topic.",
      "type": "object",
      "properties": {
        "topicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "body": { "type": "string", "minLength": 2, "maxLength": 4000 },
        "parentReplyId": { "type": "string", "maxLength": 128 },
        "isAcceptedAnswer": { "type": "boolean" },
        "upvotesCount": { "type": "integer" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "topicId", "authorId", "authorName", "authorPhoto", "body",
        "parentReplyId", "isAcceptedAnswer", "upvotesCount", "isDeleted",
        "createdAt", "updatedAt"
      ]
    },
    "Vote": {
      "title": "Vote",
      "description": "Single-user upvote record preventing duplicate voting.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Safety moderation report for spam, harassment, or misinformation.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["topic", "reply", "video"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "topicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "enum": ["spam", "harassment", "misinformation", "unlawful", "other"] },
        "ruleNumber": { "type": "integer", "description": "Optional community rule number (1-13)." },
        "details": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "topicId", "reason", "details", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A real-time community group chat message with optional image or document attachment.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "senderPhoto": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 2000 },
        "attachmentType": { "type": "string", "enum": ["none", "image", "document"] },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "attachmentName": { "type": "string", "maxLength": 140 },
        "attachmentSize": { "type": "integer" },
        "attachmentMime": { "type": "string", "maxLength": 120 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToSenderName": { "type": "string", "maxLength": 80 },
        "replyToPreview": { "type": "string", "maxLength": 160 },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "senderId", "senderName", "senderPhoto", "text",
        "attachmentType", "attachmentUrl", "attachmentName", "attachmentSize", "attachmentMime",
        "replyToId", "replyToSenderName", "replyToPreview",
        "isDeleted", "createdAt", "updatedAt"
      ]
    },
    "MchartNote": {
      "title": "MchartNote",
      "description": "Structured community study/announcement note published by the platform owner inside Mchart.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 220 },
        "body": { "type": "string", "minLength": 5, "maxLength": 15000 },
        "summary": { "type": "string", "maxLength": 240 },
        "fileName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "wordCount": { "type": "integer" },
        "isArchived": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "pdfUrl": { "type": "string", "maxLength": 500 },
        "pdfFileName": { "type": "string", "maxLength": 140 },
        "pdfSize": { "type": "integer" },
        "noteType": { "type": "string", "enum": ["text", "pdf", "mixed"] },
        "isLocked": { "type": "boolean" },
        "lockedTargetMode": { "type": "string", "enum": ["all", "selected"] },
        "lockPrice": { "type": "integer" },
        "lockCurrency": { "type": "string", "maxLength": 10 },
        "paymentInstructions": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorId", "authorName", "title", "body", "summary",
        "fileName", "wordCount", "isArchived", "isPinned",
        "createdAt", "updatedAt"
      ]
    },
    "MchartNoteContent": {
      "title": "MchartNoteContent",
      "description": "Protected full body and PDF URL of a locked Mchart note, readable only by unlocked/paid members and owner.",
      "type": "object",
      "properties": {
        "noteId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "body": { "type": "string", "minLength": 5, "maxLength": 15000 },
        "pdfUrl": { "type": "string", "maxLength": 500 },
        "pdfFileName": { "type": "string", "maxLength": 140 },
        "pdfSize": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["noteId", "body", "pdfUrl", "pdfFileName", "pdfSize", "updatedAt"]
    },
    "MchartNoteAccess": {
      "title": "MchartNoteAccess",
      "description": "Per-user unlock, pending payment confirmation, or specific lock status for an Mchart note.",
      "type": "object",
      "properties": {
        "noteId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "unlocked", "locked"] },
        "paymentReference": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["noteId", "userId", "userName", "status", "paymentReference", "createdAt", "updatedAt"]
    },
    "MemberIdRecord": {
      "title": "MemberIdRecord",
      "description": "Registered official Malosha Forums member ID card & security serial record for anti-fake verification (zero PII).",
      "type": "object",
      "properties": {
        "cardNumber": { "type": "string", "minLength": 6, "maxLength": 32, "pattern": "^MLF-[A-Z0-9]+$" },
        "controlSerial": { "type": "string", "minLength": 8, "maxLength": 8, "pattern": "^[0-9]{8}$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["member", "moderator"] },
        "verificationBadge": { "type": "string", "enum": ["none", "individual", "organization", "government", "owner", "journalist", "educator", "creator"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "cardNumber", "controlSerial", "uid", "displayName", "photoURL",
        "role", "verificationBadge", "accountStatus",
        "issuedAt", "expiresAt", "updatedAt"
      ]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time online presence and Mchart typing indicator state per member (zero PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "isOnline": { "type": "boolean" },
        "isTypingInMchart": { "type": "boolean" },
        "replyingToName": { "type": "string", "maxLength": 80 },
        "activeArea": { "type": "string", "enum": ["kijiweni", "video", "fursa", "makala", "mchart", "profile", "forum"] },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "typingUpdatedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "displayName", "isOnline", "isTypingInMchart",
        "replyingToName", "activeArea", "lastSeenAt", "typingUpdatedAt", "updatedAt"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Facebook-style real-time reply and comment notification stored privately per recipient user.",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "actorPhoto": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["comment_reply", "post_comment", "account_moderation", "video_moderation", "post_moderation"] },
        "topicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicTitle": { "type": "string", "maxLength": 140 },
        "topicCategory": { "type": "string", "enum": ["Kijiweni", "Fursa", "Makala"] },
        "replyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentReplyId": { "type": "string", "maxLength": 128 },
        "replyPreview": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ruleNumber": { "type": "integer", "description": "Violated community rule number (1-13) for moderation alerts." },
        "ruleTitle": { "type": "string", "maxLength": 140 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "recipientId", "actorId", "actorName", "actorPhoto",
        "type", "topicId", "topicTitle", "topicCategory",
        "replyId", "parentReplyId", "replyPreview", "isRead", "createdAt"
      ]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "Private WhatsApp-style 1-on-1 direct conversation strictly restricted to its two participants.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantA": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participantB": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participants": { "type": "array", "description": "Exactly 2 sorted participant UIDs [participantA, participantB]." },
        "participantAName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "participantAPhoto": { "type": "string", "maxLength": 500 },
        "participantBName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "participantBPhoto": { "type": "string", "maxLength": 500 },
        "lastMessageText": { "type": "string", "maxLength": 200 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCountA": { "type": "integer" },
        "unreadCountB": { "type": "integer" },
        "lastReadAtA": { "type": "string", "format": "date-time" },
        "lastReadAtB": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "chatId", "participantA", "participantB", "participants",
        "participantAName", "participantAPhoto", "participantBName", "participantBPhoto",
        "lastMessageText", "lastSenderId", "lastMessageAt",
        "unreadCountA", "unreadCountB", "lastReadAtA", "lastReadAtB",
        "createdAt", "updatedAt"
      ]
    },
    "DirectChatMessage": {
      "title": "DirectChatMessage",
      "description": "End-user private 1-on-1 message readable only by the two participants of the direct chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "participants": { "type": "array", "description": "Exactly 2 participant UIDs matching parent thread." },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "senderPhoto": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 2000 },
        "attachmentType": { "type": "string", "enum": ["none", "image", "document"] },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "attachmentName": { "type": "string", "maxLength": 140 },
        "attachmentSize": { "type": "integer" },
        "attachmentMime": { "type": "string", "maxLength": 120 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToSenderName": { "type": "string", "maxLength": 80 },
        "replyToPreview": { "type": "string", "maxLength": 160 },
        "isDeleted": { "type": "boolean" },
        "viewOnce": { "type": "boolean" },
        "viewOnceConsumed": { "type": "boolean" },
        "viewOnceOpenedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "chatId", "participants", "senderId", "senderName", "senderPhoto", "text",
        "attachmentType", "attachmentUrl", "attachmentName", "attachmentSize", "attachmentMime",
        "replyToId", "replyToSenderName", "replyToPreview",
        "isDeleted", "createdAt", "updatedAt"
      ]
    },
    "MchartStatus": {
      "title": "MchartStatus",
      "description": "24-hour WhatsApp-style ephemeral photo status with strict audience privacy.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "minLength": 10, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 280 },
        "privacy": { "type": "string", "enum": ["members", "selected"] },
        "allowedViewerIds": { "type": "array", "description": "Up to 50 permitted viewer UIDs when privacy is selected." },
        "audienceTokens": { "type": "array", "description": "Indexed visibility tokens: ['__MEMBERS__'] or [authorId, ...allowedViewerIds]." },
        "viewsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorId", "authorName", "authorPhoto", "imageUrl", "caption",
        "privacy", "allowedViewerIds", "audienceTokens", "viewsCount",
        "createdAt", "expiresAt"
      ]
    },
    "MchartStatusView": {
      "title": "MchartStatusView",
      "description": "Status view receipt readable strictly by the status author and the viewer themselves.",
      "type": "object",
      "properties": {
        "statusId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "statusAuthorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "viewerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "viewerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "viewerPhoto": { "type": "string", "maxLength": 500 },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["statusId", "statusAuthorId", "viewerId", "viewerName", "viewerPhoto", "viewedAt"]
    },
    "VideoPost": {
      "title": "VideoPost",
      "description": "TikTok-style short vertical video or photo-with-music carousel uploaded to Cloudinary by a verified member.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "mediaType": { "type": "string", "enum": ["video", "photo"] },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "photoUrls": { "type": "array", "description": "Up to 10 Cloudinary HTTPS image URLs for photo carousel posts." },
        "audioUrl": { "type": "string", "maxLength": 500 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 240 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 600 },
        "soundName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tags": { "type": "array", "description": "Up to 5 short hashtags." },
        "durationSec": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "isArchived": { "type": "boolean" },
        "allowComments": { "type": "boolean" },
        "allowDownload": { "type": "boolean" },
        "allowLikes": { "type": "boolean" },
        "showLikeCount": { "type": "boolean" },
        "autoReplyEnabled": { "type": "boolean" },
        "autoReplyMessage": { "type": "string", "maxLength": 300 },
        "autoReplyTrigger": { "type": "string", "enum": ["all", "keyword"] },
        "autoReplyKeyword": { "type": "string", "maxLength": 60 },
        "moderationRuleNumber": { "type": "integer" },
        "moderationReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorId", "authorName", "authorPhoto", "videoUrl", "cloudinaryPublicId", "thumbnailUrl",
        "caption", "soundName", "tags", "durationSec",
        "likesCount", "commentsCount", "sharesCount", "isArchived",
        "createdAt", "updatedAt"
